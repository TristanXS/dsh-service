#!/bin/bash
set -u

MANAGER_VERSION=0.1.0

die() {
  printf 'dsh-mac: error: %s\n' "$*" >&2
  return 1
}

note() {
  printf 'dsh-mac: %s\n' "$*" >&2
}

init_command_paths() {
  LAUNCHCTL_BIN=/bin/launchctl
  PLUTIL_BIN=/usr/bin/plutil
  LSOF_BIN=/usr/sbin/lsof
  CURL_BIN=/usr/bin/curl
  OPEN_BIN=/usr/bin/open
  TAIL_BIN=/usr/bin/tail
  WAIT_ATTEMPTS=30
  WAIT_INTERVAL=1
  if [ "${DSH_MAC_TESTING:-0}" = 1 ]; then
    LAUNCHCTL_BIN="${DSH_MAC_LAUNCHCTL_BIN:-$LAUNCHCTL_BIN}"
    PLUTIL_BIN="${DSH_MAC_PLUTIL_BIN:-$PLUTIL_BIN}"
    LSOF_BIN="${DSH_MAC_LSOF_BIN:-$LSOF_BIN}"
    CURL_BIN="${DSH_MAC_CURL_BIN:-$CURL_BIN}"
    OPEN_BIN="${DSH_MAC_OPEN_BIN:-$OPEN_BIN}"
    TAIL_BIN="${DSH_MAC_TAIL_BIN:-$TAIL_BIN}"
    WAIT_ATTEMPTS="${DSH_MAC_WAIT_ATTEMPTS:-3}"
    WAIT_INTERVAL="${DSH_MAC_WAIT_INTERVAL:-0}"
  fi
}

init_paths() {
  DSH_MAC_ROOT="$HOME/Library/Application Support/dsh-mac"
  RELEASES_DIR="$DSH_MAC_ROOT/releases"
  CURRENT_LINK="$DSH_MAC_ROOT/current"
  PREVIOUS_LINK="$DSH_MAC_ROOT/previous"
  ACTIVATION_FILE="$DSH_MAC_ROOT/activation.env"
  LOCK_DIR="$DSH_MAC_ROOT/.lock"
  WORKSPACE_DIR="$DSH_MAC_ROOT/workspace"
  RUNNER_TEMPLATE="$DSH_MAC_ROOT/libexec/dsh-mac-run"
  CLI_DEST="$HOME/.local/bin/dsh-mac"
  PLIST_PATH="$HOME/Library/LaunchAgents/dev.dsh-mac.web.plist"
  LOG_DIR="$HOME/Library/Logs/dsh-mac"
  SERVICE_TARGET="gui/$(/usr/bin/id -u)/dev.dsh-mac.web"
}

node_version_supported() {
  [ "$#" -eq 1 ] || return 1

  version=$1
  case "$version" in
    *.*.*) ;;
    *) return 1 ;;
  esac

  major=${version%%.*}
  remainder=${version#*.}
  minor=${remainder%%.*}
  patch=${remainder#*.}

  case "$patch" in
    *.*) return 1 ;;
  esac
  case "$major" in
    ''|*[!0-9]*) return 1 ;;
  esac
  case "$minor" in
    ''|*[!0-9]*) return 1 ;;
  esac
  case "$patch" in
    ''|*[!0-9]*) return 1 ;;
  esac

  while [ "${major#0}" != "$major" ]; do
    major=${major#0}
  done
  while [ "${minor#0}" != "$minor" ]; do
    minor=${minor#0}
  done
  major=${major:-0}
  minor=${minor:-0}

  case ${#major} in
    1) return 1 ;;
    2)
      case "$major" in
        22)
          case ${#minor} in
            1) return 1 ;;
            2)
              case "$minor" in
                1[9]|[2-9][0-9]) return 0 ;;
                *) return 1 ;;
              esac
              ;;
            *) return 0 ;;
          esac
          ;;
        23) return 1 ;;
        2[4-9]|[3-9][0-9]) return 0 ;;
        *) return 1 ;;
      esac
      ;;
    *) return 0 ;;
  esac
}

validate_release_id() {
  [ "$#" -eq 1 ] || return 1
  release_id_pattern='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?-[0-9]+-[0-9]+$'
  [[ "$1" =~ $release_id_pattern ]]
}

cli_relative_safe() {
  [ "$#" -eq 1 ] || return 1
  case "$1" in
    ''|/*|.|..|./*|../*|*/./*|*/../*|*/.|*/..|*//* ) return 1 ;;
  esac
  return 0
}

read_manifest() {
  [ "$#" -eq 1 ] || {
    die 'read_manifest requires a path'
    return 1
  }
  manifest_path=$1
  [ -r "$manifest_path" ] || {
    die "cannot read manifest: $manifest_path"
    return 1
  }

  manifest_schema=
  manifest_dsh_version=
  manifest_node_bin=
  manifest_cli_relative=
  manifest_installed_at=
  seen_schema=0
  seen_dsh_version=0
  seen_node_bin=0
  seen_cli_relative=0
  seen_installed_at=0

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      *=*) ;;
      *)
        die "malformed manifest line: $line"
        return 1
        ;;
    esac
    key=${line%%=*}
    value=${line#*=}
    case "$key" in
      SCHEMA_VERSION)
        [ "$seen_schema" -eq 0 ] || {
          die 'duplicate manifest key: SCHEMA_VERSION'
          return 1
        }
        seen_schema=1
        manifest_schema=$value
        ;;
      DSH_VERSION)
        [ "$seen_dsh_version" -eq 0 ] || {
          die 'duplicate manifest key: DSH_VERSION'
          return 1
        }
        seen_dsh_version=1
        manifest_dsh_version=$value
        ;;
      NODE_BIN)
        [ "$seen_node_bin" -eq 0 ] || {
          die 'duplicate manifest key: NODE_BIN'
          return 1
        }
        seen_node_bin=1
        manifest_node_bin=$value
        ;;
      CLI_RELATIVE)
        [ "$seen_cli_relative" -eq 0 ] || {
          die 'duplicate manifest key: CLI_RELATIVE'
          return 1
        }
        seen_cli_relative=1
        manifest_cli_relative=$value
        ;;
      INSTALLED_AT)
        [ "$seen_installed_at" -eq 0 ] || {
          die 'duplicate manifest key: INSTALLED_AT'
          return 1
        }
        seen_installed_at=1
        manifest_installed_at=$value
        ;;
      *)
        die "unknown manifest key: $key"
        return 1
        ;;
    esac
  done <"$manifest_path"

  [ "$seen_schema" -eq 1 ] &&
    [ "$seen_dsh_version" -eq 1 ] &&
    [ "$seen_node_bin" -eq 1 ] &&
    [ "$seen_cli_relative" -eq 1 ] &&
    [ "$seen_installed_at" -eq 1 ] || {
      die 'manifest is missing required keys'
      return 1
    }
  [ "$manifest_schema" = 1 ] || {
    die 'unsupported manifest schema'
    return 1
  }
  [ -n "$manifest_dsh_version" ] || {
    die 'manifest DSH_VERSION is empty'
    return 1
  }
  case "$manifest_node_bin" in
    /*) ;;
    *)
      die 'manifest NODE_BIN must be absolute'
      return 1
      ;;
  esac
  [ -f "$manifest_node_bin" ] && [ -x "$manifest_node_bin" ] || {
    die 'manifest NODE_BIN must be executable'
    return 1
  }
  cli_relative_safe "$manifest_cli_relative" || {
    die 'manifest CLI_RELATIVE is unsafe'
    return 1
  }
  case "$manifest_installed_at" in
    ''|*[!0-9]*)
      die 'manifest INSTALLED_AT must be numeric'
      return 1
      ;;
  esac

  MANIFEST_SCHEMA_VERSION=$manifest_schema
  MANIFEST_DSH_VERSION=$manifest_dsh_version
  MANIFEST_NODE_BIN=$manifest_node_bin
  MANIFEST_CLI_RELATIVE=$manifest_cli_relative
  MANIFEST_INSTALLED_AT=$manifest_installed_at
}

read_activation() {
  activation_path=${1:-$ACTIVATION_FILE}
  [ "$#" -le 1 ] || {
    die 'read_activation accepts at most one path'
    return 1
  }
  [ -r "$activation_path" ] || {
    die "cannot read activation: $activation_path"
    return 1
  }

  activation_schema=
  activation_old_release=
  activation_candidate_release=
  seen_schema=0
  seen_old_release=0
  seen_candidate_release=0

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      *=*) ;;
      *)
        die "malformed activation line: $line"
        return 1
        ;;
    esac
    key=${line%%=*}
    value=${line#*=}
    case "$key" in
      SCHEMA_VERSION)
        [ "$seen_schema" -eq 0 ] || {
          die 'duplicate activation key: SCHEMA_VERSION'
          return 1
        }
        seen_schema=1
        activation_schema=$value
        ;;
      OLD_RELEASE)
        [ "$seen_old_release" -eq 0 ] || {
          die 'duplicate activation key: OLD_RELEASE'
          return 1
        }
        seen_old_release=1
        activation_old_release=$value
        ;;
      CANDIDATE_RELEASE)
        [ "$seen_candidate_release" -eq 0 ] || {
          die 'duplicate activation key: CANDIDATE_RELEASE'
          return 1
        }
        seen_candidate_release=1
        activation_candidate_release=$value
        ;;
      *)
        die "unknown activation key: $key"
        return 1
        ;;
    esac
  done <"$activation_path"

  [ "$seen_schema" -eq 1 ] &&
    [ "$seen_old_release" -eq 1 ] &&
    [ "$seen_candidate_release" -eq 1 ] || {
      die 'activation is missing required keys'
      return 1
    }
  [ "$activation_schema" = 1 ] || {
    die 'unsupported activation schema'
    return 1
  }
  if [ "$activation_old_release" != NONE ]; then
    validate_release_id "$activation_old_release" || {
      die 'activation OLD_RELEASE is invalid'
      return 1
    }
  fi
  validate_release_id "$activation_candidate_release" || {
    die 'activation CANDIDATE_RELEASE is invalid'
    return 1
  }

  ACTIVATION_SCHEMA_VERSION=$activation_schema
  ACTIVATION_OLD_RELEASE=$activation_old_release
  ACTIVATION_CANDIDATE_RELEASE=$activation_candidate_release
}

preflight_common() {
  [ "$(/usr/bin/uname -s 2>/dev/null)" = Darwin ] || {
    die 'macOS is required'
    return 1
  }
  case "$HOME" in
    '')
      die 'HOME must not be empty'
      return 1
      ;;
    /*) ;;
    *)
      die 'HOME must be absolute'
      return 1
      ;;
  esac
  case "$HOME" in
    *"
"*)
      die 'HOME must not contain a newline'
      return 1
      ;;
  esac
  case "$LAUNCHCTL_BIN" in
    /*) ;;
    *)
      die 'launchctl path must be absolute'
      return 1
      ;;
  esac
  [ -x "$LAUNCHCTL_BIN" ] || {
    die 'launchctl is unavailable'
    return 1
  }
  "$LAUNCHCTL_BIN" print "gui/$(/usr/bin/id -u)" >/dev/null 2>&1 || {
    die 'launchd GUI domain is unavailable'
    return 1
  }

  for command_path in "$@"; do
    case "$command_path" in
      /*) ;;
      *)
        die "command path must be absolute: $command_path"
        return 1
        ;;
    esac
    [ -f "$command_path" ] && [ -x "$command_path" ] || {
      die "required command is unavailable: $command_path"
      return 1
    }
  done
}

resolve_external_command() {
  [ "$#" -eq 1 ] || return 1
  command_name=$1
  command_kind=$(type -t "$command_name" 2>/dev/null) || return 1
  [ "$command_kind" = file ] || return 1
  command_path=$(command -v "$command_name" 2>/dev/null) || return 1
  case "$command_path" in
    /*) ;;
    *) return 1 ;;
  esac
  [ -x "$command_path" ] || return 1
  printf '%s\n' "$command_path"
}

resolve_node_and_npm() {
  [ "$#" -eq 0 ] || {
    die 'resolve_node_and_npm accepts no arguments'
    return 1
  }
  resolved_node=$(resolve_external_command node) || {
    die 'node must resolve to an absolute executable, not an alias or function'
    return 1
  }
  resolved_npm=$(resolve_external_command npm) || {
    die 'npm must resolve to an absolute executable, not an alias or function'
    return 1
  }
  raw_node_version=$("$resolved_node" --version 2>/dev/null) || {
    die 'could not read the Node.js version'
    return 1
  }
  resolved_node_version=${raw_node_version#v}
  node_version_supported "$resolved_node_version" || {
    die "unsupported Node.js version: $raw_node_version"
    return 1
  }

  NODE_BIN=$resolved_node
  NPM_BIN=$resolved_npm
  NODE_VERSION=$resolved_node_version
}

preflight_install() {
  preflight_common "$PLUTIL_BIN" "$LSOF_BIN" "$CURL_BIN" "$OPEN_BIN" || return 1
  resolve_node_and_npm
}

resolve_latest_version() {
  [ "$#" -eq 0 ] || {
    die 'resolve_latest_version accepts no arguments'
    return 1
  }
  [ -n "${NPM_BIN:-}" ] && [ -f "$NPM_BIN" ] && [ -x "$NPM_BIN" ] || {
    die 'npm is unavailable'
    return 1
  }

  resolved_latest_version=$("$NPM_BIN" view @deepseek-ai/dsh@latest version) || {
    die 'could not resolve the latest DSH version'
    return 1
  }
  case "$resolved_latest_version" in
    ''|*[!0-9A-Za-z.-]*)
      die 'latest DSH version is malformed'
      return 1
      ;;
  esac
  latest_version_pattern='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$'
  [[ "$resolved_latest_version" =~ $latest_version_pattern ]] || {
    die 'latest DSH version is malformed'
    return 1
  }

  LATEST_VERSION=$resolved_latest_version
}

resolve_release_cli() {
  [ "$#" -eq 2 ] || return 1
  resolve_release_root=$1
  resolve_cli_relative=$2
  cli_relative_safe "$resolve_cli_relative" || return 1
  [ -d "$resolve_release_root" ] && [ ! -L "$resolve_release_root" ] || return 1

  resolved_release_root=$(CDPATH= cd -P -- "$resolve_release_root" && pwd) || return 1
  cli_candidate="$resolved_release_root/$resolve_cli_relative"
  [ -f "$cli_candidate" ] && [ ! -L "$cli_candidate" ] || return 1
  cli_parent=$(CDPATH= cd -P -- "$(dirname -- "$cli_candidate")" && pwd) || return 1
  case "$cli_parent/" in
    "$resolved_release_root/"*) ;;
    *) return 1 ;;
  esac

  RESOLVED_CLI_ENTRY="$cli_parent/$(basename -- "$cli_candidate")"
}

cli_version_matches() (
  [ "$#" -eq 2 ] || return 1
  expected_cli_version=$1
  cli_version_text=$2
  [ -n "$cli_version_text" ] || return 1
  case "$cli_version_text" in
    *"
"*) return 1 ;;
  esac

  cli_version_pattern='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$'
  matched_cli_version=
  cli_version_count=0
  set -f
  for cli_version_token in $cli_version_text; do
    case "$cli_version_token" in
      v[0-9]*) cli_version_token=${cli_version_token#v} ;;
    esac
    if [[ "$cli_version_token" =~ $cli_version_pattern ]]; then
      matched_cli_version=$cli_version_token
      cli_version_count=$((cli_version_count + 1))
    fi
  done
  [ "$cli_version_count" -eq 1 ] && [ "$matched_cli_version" = "$expected_cli_version" ]
)

release_root_is_owned() {
  [ "$#" -eq 0 ] || return 1
  [ -d "$DSH_MAC_ROOT" ] && [ ! -L "$DSH_MAC_ROOT" ] || return 1
  [ -d "$RELEASES_DIR" ] && [ ! -L "$RELEASES_DIR" ] || return 1

  owned_root_physical=$(CDPATH= cd -P -- "$DSH_MAC_ROOT" && pwd) || return 1
  owned_releases_physical=$(CDPATH= cd -P -- "$RELEASES_DIR" && pwd) || return 1
  [ "$owned_releases_physical" = "$owned_root_physical/releases" ]
}

release_dir_is_owned() {
  [ "$#" -eq 1 ] || return 1
  release_root_is_owned || return 1
  owned_release_candidate=$1
  [ -d "$owned_release_candidate" ] && [ ! -L "$owned_release_candidate" ] || return 1
  owned_release_physical=$(CDPATH= cd -P -- "$owned_release_candidate" && pwd) || return 1
  owned_release_parent=$(CDPATH= cd -P -- "$owned_release_physical/.." && pwd) || return 1
  [ "$owned_release_parent" = "$owned_releases_physical" ]
}

validate_release() {
  [ "$#" -eq 1 ] || {
    die 'validate_release requires a release path'
    return 1
  }
  release_path=$1
  release_dir_is_owned "$release_path" || {
    die 'release directory is unavailable'
    return 1
  }
  [ -f "$release_path/.complete" ] && [ ! -L "$release_path/.complete" ] || {
    die 'release is incomplete'
    return 1
  }
  [ -f "$release_path/run" ] && [ -x "$release_path/run" ] && [ ! -L "$release_path/run" ] || {
    die 'release runner is unavailable'
    return 1
  }

  read_manifest "$release_path/manifest.env" || return 1
  resolve_release_cli "$release_path" "$MANIFEST_CLI_RELATIVE" || {
    die 'release CLI path is invalid'
    return 1
  }
  release_cli_entry=$RESOLVED_CLI_ENTRY

  runner_version=$("$release_path/run" --check) || {
    die 'release runner validation failed'
    return 1
  }
  [ "$runner_version" = "$MANIFEST_DSH_VERSION" ] || {
    die 'release runner reported the wrong version'
    return 1
  }
  cli_version_output=$("$MANIFEST_NODE_BIN" "$release_cli_entry" --version 2>&1) || {
    die 'release CLI version probe failed'
    return 1
  }
  cli_version_matches "$MANIFEST_DSH_VERSION" "$cli_version_output" || {
    die 'release CLI reported the wrong version'
    return 1
  }
}

current_release_id() {
  [ "$#" -eq 0 ] || return 1
  [ -L "$CURRENT_LINK" ] || return 1
  current_target=$(/usr/bin/readlink "$CURRENT_LINK") || return 1
  case "$current_target" in
    releases/*) current_id=${current_target#releases/} ;;
    *) return 1 ;;
  esac
  validate_release_id "$current_id" || return 1
  release_dir_is_owned "$RELEASES_DIR/$current_id" || return 1
  printf '%s\n' "$current_id"
}

atomic_release_link() {
  [ "$#" -eq 2 ] || {
    die 'atomic_release_link requires a link path and release ID'
    return 1
  }
  link_path=$1
  release_id=$2
  case "$link_path" in
    "$CURRENT_LINK"|"$PREVIOUS_LINK") ;;
    *)
      die 'release link path is not manager-owned'
      return 1
      ;;
  esac
  validate_release_id "$release_id" || {
    die 'release ID is invalid'
    return 1
  }
  release_dir_is_owned "$RELEASES_DIR/$release_id" || {
    die 'release directory does not exist'
    return 1
  }
  if { [ -e "$link_path" ] || [ -L "$link_path" ]; } && [ ! -L "$link_path" ]; then
    die 'release link target must be absent or a symlink'
    return 1
  fi

  link_serial=$$
  link_tmp="$DSH_MAC_ROOT/.release-link-$link_serial"
  while [ -e "$link_tmp" ] || [ -L "$link_tmp" ]; do
    link_serial=$((link_serial + 1))
    link_tmp="$DSH_MAC_ROOT/.release-link-$link_serial"
  done
  expected_link_target="releases/$release_id"
  /bin/ln -s "$expected_link_target" "$link_tmp" || {
    die 'could not create temporary release link'
    return 1
  }
  if ! /bin/mv -f "$link_tmp" "$link_path"; then
    /bin/rm -f -- "$link_tmp"
    die 'could not publish release link'
    return 1
  fi
  published_link_target=$(/usr/bin/readlink "$link_path" 2>/dev/null) || {
    die 'published release link is invalid'
    return 1
  }
  [ -L "$link_path" ] && [ "$published_link_target" = "$expected_link_target" ] || {
    die 'published release link is invalid'
    return 1
  }
}

current_matches() {
  [ "$#" -eq 1 ] || return 1
  wanted_version=$1
  matching_release_id=$(current_release_id) || return 1
  matching_release_path="$RELEASES_DIR/$matching_release_id"
  validate_release "$matching_release_path" || return 1
  [ "$MANIFEST_DSH_VERSION" = "$wanted_version" ] || return 1
  printf '%s\n' "$matching_release_id"
}

remove_staging_release() {
  [ "$#" -eq 1 ] || return 1
  case "$1" in
    "$RELEASES_DIR"/.staging-*) /bin/rm -rf -- "$1" ;;
    *) return 1 ;;
  esac
}

stage_release() {
  [ "$#" -eq 0 ] || {
    die 'stage_release accepts no arguments'
    return 1
  }
  resolve_latest_version || return 1

  matching_release=$(current_matches "$LATEST_VERSION" 2>/dev/null) && {
    STAGED_RELEASE_ID=$matching_release
    STAGED_RELEASE_PATH="$RELEASES_DIR/$matching_release"
    return 0
  }

  [ -n "${NODE_BIN:-}" ] && [ -f "$NODE_BIN" ] && [ -x "$NODE_BIN" ] || {
    die 'Node.js is unavailable'
    return 1
  }
  [ -f "$RUNNER_TEMPLATE" ] && [ -x "$RUNNER_TEMPLATE" ] && [ ! -L "$RUNNER_TEMPLATE" ] || {
    die 'manager-owned runner template is unavailable'
    return 1
  }
  /bin/mkdir -p "$RELEASES_DIR" || {
    die 'could not create releases directory'
    return 1
  }
  [ ! -L "$RELEASES_DIR" ] || {
    die 'releases directory must not be a symlink'
    return 1
  }

  installed_at=$(/bin/date +%s) || {
    die 'could not read installation time'
    return 1
  }
  release_serial=$$
  while :; do
    release_id="$LATEST_VERSION-$installed_at-$release_serial"
    validate_release_id "$release_id" || {
      die 'could not create a valid release ID'
      return 1
    }
    final_release="$RELEASES_DIR/$release_id"
    staging_release="$RELEASES_DIR/.staging-$installed_at-$release_serial"
    if [ ! -e "$final_release" ] && [ ! -L "$final_release" ] &&
      [ ! -e "$staging_release" ] && [ ! -L "$staging_release" ]; then
      break
    fi
    release_serial=$((release_serial + 1))
  done

  /bin/mkdir "$staging_release" || {
    die 'could not create staging directory'
    return 1
  }

  if ! "$NPM_BIN" install --prefix "$staging_release" "@deepseek-ai/dsh@$LATEST_VERSION" \
    --no-save --package-lock=false --omit=dev --no-audit --no-fund; then
    remove_staging_release "$staging_release" || :
    die 'could not install DSH release'
    return 1
  fi
  [ ! -e "$staging_release/package-lock.json" ] || {
    remove_staging_release "$staging_release" || :
    die 'npm created an unexpected package lock'
    return 1
  }

  package_json="$staging_release/node_modules/@deepseek-ai/dsh/package.json"
  [ -f "$package_json" ] && [ ! -L "$package_json" ] || {
    remove_staging_release "$staging_release" || :
    die 'installed DSH package metadata is unavailable'
    return 1
  }
  package_metadata=$("$NODE_BIN" -e '
const fs = require("fs");
const pkg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
if (typeof pkg.version !== "string" || !pkg.bin || typeof pkg.bin.dsh !== "string") process.exit(1);
process.stdout.write(pkg.version + "\n" + pkg.bin.dsh + "\n");
' "$package_json") || {
    remove_staging_release "$staging_release" || :
    die 'could not read installed DSH package metadata'
    return 1
  }
  metadata_newline='
'
  case "$package_metadata" in
    *"$metadata_newline"*) ;;
    *)
      remove_staging_release "$staging_release" || :
      die 'installed DSH package metadata is malformed'
      return 1
      ;;
  esac
  installed_version=${package_metadata%%"$metadata_newline"*}
  package_cli=${package_metadata#*"$metadata_newline"}
  case "$package_cli" in
    *"$metadata_newline"*|'')
      remove_staging_release "$staging_release" || :
      die 'installed DSH package metadata is malformed'
      return 1
      ;;
  esac
  [ "$installed_version" = "$LATEST_VERSION" ] || {
    remove_staging_release "$staging_release" || :
    die 'installed DSH package version does not match latest'
    return 1
  }
  while case "$package_cli" in ./*) true ;; *) false ;; esac; do
    package_cli=${package_cli#./}
  done
  cli_relative="node_modules/@deepseek-ai/dsh/$package_cli"
  cli_relative_safe "$cli_relative" || {
    remove_staging_release "$staging_release" || :
    die 'installed DSH CLI path is unsafe'
    return 1
  }
  resolve_release_cli "$staging_release" "$cli_relative" || {
    remove_staging_release "$staging_release" || :
    die 'installed DSH CLI escapes staging'
    return 1
  }
  staged_cli_entry=$RESOLVED_CLI_ENTRY

  manifest_tmp="$staging_release/.manifest-$release_serial"
  if ! (
    umask 077
    {
      printf 'SCHEMA_VERSION=1\n'
      printf 'DSH_VERSION=%s\n' "$installed_version"
      printf 'NODE_BIN=%s\n' "$NODE_BIN"
      printf 'CLI_RELATIVE=%s\n' "$cli_relative"
      printf 'INSTALLED_AT=%s\n' "$installed_at"
    } >"$manifest_tmp"
  ); then
    remove_staging_release "$staging_release" || :
    die 'could not write release manifest'
    return 1
  fi
  if ! /bin/mv "$manifest_tmp" "$staging_release/manifest.env"; then
    remove_staging_release "$staging_release" || :
    die 'could not publish release manifest'
    return 1
  fi
  if ! /bin/cp "$RUNNER_TEMPLATE" "$staging_release/run" ||
    ! /bin/chmod 0755 "$staging_release/run"; then
    remove_staging_release "$staging_release" || :
    die 'could not install release runner'
    return 1
  fi

  staged_runner_version=$("$staging_release/run" --check) || {
    remove_staging_release "$staging_release" || :
    die 'staged runner validation failed'
    return 1
  }
  [ "$staged_runner_version" = "$installed_version" ] || {
    remove_staging_release "$staging_release" || :
    die 'staged runner reported the wrong version'
    return 1
  }
  staged_cli_output=$("$NODE_BIN" "$staged_cli_entry" --version 2>&1) || {
    remove_staging_release "$staging_release" || :
    die 'staged DSH version probe failed'
    return 1
  }
  cli_version_matches "$installed_version" "$staged_cli_output" || {
    remove_staging_release "$staging_release" || :
    die 'staged DSH reported the wrong version'
    return 1
  }

  : >"$staging_release/.complete" || {
    remove_staging_release "$staging_release" || :
    die 'could not mark staged release complete'
    return 1
  }
  if ! /bin/mv "$staging_release" "$final_release"; then
    remove_staging_release "$staging_release" || :
    die 'could not publish staged release'
    return 1
  fi

  STAGED_RELEASE_ID=$release_id
  STAGED_RELEASE_PATH=$final_release
}

read_lock_owner() {
  [ -f "$LOCK_DIR/pid" ] || return 1
  lock_owner=
  lock_owner_lines=0
  while IFS= read -r lock_owner_line || [ -n "$lock_owner_line" ]; do
    lock_owner=$lock_owner_line
    lock_owner_lines=$((lock_owner_lines + 1))
  done <"$LOCK_DIR/pid"
  [ "$lock_owner_lines" -eq 1 ] || return 1
  case "$lock_owner" in
    ''|0|*[!0-9]*) return 1 ;;
  esac
  printf '%s\n' "$lock_owner"
}

release_lock_if_owned() {
  [ -d "$LOCK_DIR" ] || return 0
  [ ! -L "$LOCK_DIR" ] || return 0
  current_owner=$(read_lock_owner) || return 0
  [ "$current_owner" = "$$" ] || return 0
  /bin/rm -f -- "$LOCK_DIR/pid" || return 0
  /bin/rmdir -- "$LOCK_DIR" 2>/dev/null || return 0
}

release_lock() {
  [ -d "$LOCK_DIR" ] || {
    die 'operation lock does not exist'
    return 1
  }
  [ ! -L "$LOCK_DIR" ] || {
    die 'operation lock must not be a symlink'
    return 1
  }
  current_owner=$(read_lock_owner) || {
    die 'operation lock owner is malformed'
    return 1
  }
  [ "$current_owner" = "$$" ] || {
    die 'operation lock is owned by another process'
    return 1
  }
  /bin/rm -f -- "$LOCK_DIR/pid" || {
    die 'could not remove operation lock owner file'
    return 1
  }
  /bin/rmdir -- "$LOCK_DIR" || {
    die 'could not remove operation lock directory'
    return 1
  }
}

acquire_lock() {
  if /bin/mkdir "$LOCK_DIR" 2>/dev/null; then
    if printf '%s\n' "$$" >"$LOCK_DIR/pid"; then
      trap 'release_lock_if_owned' EXIT
      trap 'exit 130' INT
      trap 'exit 143' TERM
      return 0
    fi
    /bin/rmdir -- "$LOCK_DIR" 2>/dev/null || :
    die 'could not record operation lock owner'
    return 1
  fi

  [ -d "$LOCK_DIR" ] || {
    die 'could not create operation lock'
    return 1
  }
  [ ! -L "$LOCK_DIR" ] || {
    die 'operation lock must not be a symlink'
    return 1
  }
  stale_owner=$(read_lock_owner) || {
    die 'operation lock owner is missing or malformed'
    return 1
  }
  if kill -0 "$stale_owner" 2>/dev/null; then
    die "another dsh-mac operation is running (pid $stale_owner)"
    return 1
  fi

  current_owner=$(read_lock_owner) || {
    die 'operation lock changed while checking its owner'
    return 1
  }
  [ "$current_owner" = "$stale_owner" ] || {
    die 'operation lock changed while checking its owner'
    return 1
  }
  /bin/rm -f -- "$LOCK_DIR/pid" || {
    die 'could not remove stale operation lock owner file'
    return 1
  }
  /bin/rmdir -- "$LOCK_DIR" || {
    die 'could not remove stale operation lock directory'
    return 1
  }
  /bin/mkdir "$LOCK_DIR" 2>/dev/null || {
    die 'operation lock was acquired by another process'
    return 1
  }
  if printf '%s\n' "$$" >"$LOCK_DIR/pid"; then
    trap 'release_lock_if_owned' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    return 0
  fi
  /bin/rmdir -- "$LOCK_DIR" 2>/dev/null || :
  die 'could not record operation lock owner'
  return 1
}

main() {
  command_name=${1:-}
  case "$command_name" in
    version)
      [ "$#" -eq 1 ] || {
        die 'usage: dsh-mac version'
        return 1
      }
      printf '%s\n' "$MANAGER_VERSION"
      ;;
    *)
      die 'usage: dsh-mac version'
      return 1
      ;;
  esac
}

init_command_paths
init_paths

if [ "${DSH_MAC_SOURCE_ONLY:-0}" = 1 ]; then
  return 0 2>/dev/null || exit 0
fi

main "$@"
