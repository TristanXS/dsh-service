#!/bin/bash
# shellcheck disable=SC2016,SC2034,SC2119,SC2120,SC2317
set -u

MANAGER_VERSION=0.1.0
MANAGER_SCRIPT_PATH=${BASH_SOURCE[0]}

die() {
  printf 'dsh-service: error: %s\n' "$*" >&2
  return 1
}

note() {
  printf 'dsh-service: %s\n' "$*" >&2
}

detect_platform() {
  [ "$#" -eq 0 ] || return 1
  PLATFORM=
  if [ "${DSH_SERVICE_TESTING:-0}" = 1 ] && [ -n "${DSH_SERVICE_PLATFORM:-}" ]; then
    PLATFORM=$DSH_SERVICE_PLATFORM
  else
    case "$(/usr/bin/uname -s 2>/dev/null)" in
      Darwin) PLATFORM=darwin ;;
      Linux) PLATFORM=linux ;;
    esac
  fi
  case "$PLATFORM" in
    darwin|linux) ;;
    *)
      die 'unsupported platform'
      return 1
      ;;
  esac
}

init_command_paths() {
  CURL_BIN=/usr/bin/curl
  TAIL_BIN=/usr/bin/tail
  WAIT_ATTEMPTS=30
  WAIT_INTERVAL=1
  WAIT_TIMEOUT_SECONDS=30
  case "$PLATFORM" in
    darwin)
      LAUNCHCTL_BIN=/bin/launchctl
      PLUTIL_BIN=/usr/bin/plutil
      LSOF_BIN=/usr/sbin/lsof
      OPEN_BIN=/usr/bin/open
      ;;
    linux)
      SYSTEMCTL_BIN=/usr/bin/systemctl
      SS_BIN=/usr/bin/ss
      LOGINCTL_BIN=/usr/bin/loginctl
      ;;
  esac
  if [ "${DSH_SERVICE_TESTING:-0}" = 1 ]; then
    CURL_BIN="${DSH_SERVICE_CURL_BIN:-$CURL_BIN}"
    TAIL_BIN="${DSH_SERVICE_TAIL_BIN:-$TAIL_BIN}"
    WAIT_ATTEMPTS="${DSH_SERVICE_WAIT_ATTEMPTS:-3}"
    WAIT_INTERVAL="${DSH_SERVICE_WAIT_INTERVAL:-0}"
    WAIT_TIMEOUT_SECONDS="${DSH_SERVICE_WAIT_TIMEOUT_SECONDS:-30}"
    case "$PLATFORM" in
      darwin)
        LAUNCHCTL_BIN="${DSH_SERVICE_LAUNCHCTL_BIN:-$LAUNCHCTL_BIN}"
        PLUTIL_BIN="${DSH_SERVICE_PLUTIL_BIN:-$PLUTIL_BIN}"
        LSOF_BIN="${DSH_SERVICE_LSOF_BIN:-$LSOF_BIN}"
        OPEN_BIN="${DSH_SERVICE_OPEN_BIN:-$OPEN_BIN}"
        ;;
      linux)
        SYSTEMCTL_BIN="${DSH_SERVICE_SYSTEMCTL_BIN:-$SYSTEMCTL_BIN}"
        SS_BIN="${DSH_SERVICE_SS_BIN:-$SS_BIN}"
        LOGINCTL_BIN="${DSH_SERVICE_LOGINCTL_BIN:-$LOGINCTL_BIN}"
        ;;
    esac
  fi
  case "$PLATFORM" in
    darwin) LISTENER_BIN=$LSOF_BIN ;;
    linux) LISTENER_BIN=$SS_BIN ;;
  esac
}

init_paths() {
  case "$PLATFORM" in
    darwin)
      DSH_SERVICE_ROOT="$HOME/Library/Application Support/dsh-service"
      SERVICE_DEFINITION_PATH="$HOME/Library/LaunchAgents/dev.dsh-service.web.plist"
      LOG_DIR="$HOME/Library/Logs/dsh-service"
      SERVICE_TARGET="gui/$(/usr/bin/id -u)/dev.dsh-service.web"
      ROOT_PARENT_DIR="$HOME/Library/Application Support"
      ROOT_GRANDPARENT_DIR="$HOME/Library"
      ;;
    linux)
      DSH_SERVICE_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/dsh-service"
      SERVICE_DEFINITION_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/dsh-service.service"
      LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dsh-service"
      SERVICE_TARGET=dsh-service.service
      if [ -z "${XDG_DATA_HOME:-}" ]; then
        ROOT_PARENT_DIR="$HOME/.local/share"
        ROOT_GRANDPARENT_DIR="$HOME/.local"
      else
        ROOT_PARENT_DIR=
        ROOT_GRANDPARENT_DIR=
      fi
      ;;
  esac
  RELEASES_DIR="$DSH_SERVICE_ROOT/releases"
  CURRENT_LINK="$DSH_SERVICE_ROOT/current"
  PREVIOUS_LINK="$DSH_SERVICE_ROOT/previous"
  ACTIVATION_FILE="$DSH_SERVICE_ROOT/activation.env"
  LOCK_DIR="$DSH_SERVICE_ROOT/.lock"
  WORKSPACE_DIR="$DSH_SERVICE_ROOT/workspace"
  RUNNER_TEMPLATE="$DSH_SERVICE_ROOT/libexec/dsh-service-run"
  CLI_DEST="$HOME/.local/bin/dsh-service"
}

xml_escape() {
  [ "$#" -eq 1 ] || return 1
  local escaped_value=$1
  escaped_value=${escaped_value//&/&amp;}
  escaped_value=${escaped_value//</&lt;}
  escaped_value=${escaped_value//>/&gt;}
  escaped_value=${escaped_value//\"/&quot;}
  escaped_value=${escaped_value//\'/&apos;}
  printf '%s' "$escaped_value"
}

render_plist() {
  [ "$#" -eq 0 ] || return 1
  local run_path_xml workspace_xml home_xml stdout_xml stderr_xml
  run_path_xml=$(xml_escape "$CURRENT_LINK/run") || return 1
  workspace_xml=$(xml_escape "$WORKSPACE_DIR") || return 1
  home_xml=$(xml_escape "$HOME") || return 1
  stdout_xml=$(xml_escape "$LOG_DIR/stdout.log") || return 1
  stderr_xml=$(xml_escape "$LOG_DIR/stderr.log") || return 1

  printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
  printf '%s\n' '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
  printf '%s\n' '<plist version="1.0">'
  printf '%s\n' '<dict>'
  printf '%s\n' '  <key>Label</key>'
  printf '%s\n' '  <string>dev.dsh-service.web</string>'
  printf '%s\n' '  <key>ProgramArguments</key>'
  printf '%s\n' '  <array>'
  printf '%s\n' '    <string>/bin/bash</string>'
  printf '    <string>%s</string>\n' "$run_path_xml"
  printf '%s\n' '  </array>'
  printf '%s\n' '  <key>WorkingDirectory</key>'
  printf '  <string>%s</string>\n' "$workspace_xml"
  printf '%s\n' '  <key>EnvironmentVariables</key>'
  printf '%s\n' '  <dict>'
  printf '%s\n' '    <key>HOME</key>'
  printf '    <string>%s</string>\n' "$home_xml"
  printf '%s\n' '  </dict>'
  printf '%s\n' '  <key>KeepAlive</key>'
  printf '%s\n' '  <true/>'
  printf '%s\n' '  <key>ThrottleInterval</key>'
  printf '%s\n' '  <integer>10</integer>'
  printf '%s\n' '  <key>ExitTimeOut</key>'
  printf '%s\n' '  <integer>15</integer>'
  printf '%s\n' '  <key>StandardOutPath</key>'
  printf '  <string>%s</string>\n' "$stdout_xml"
  printf '%s\n' '  <key>StandardErrorPath</key>'
  printf '  <string>%s</string>\n' "$stderr_xml"
  printf '%s\n' '</dict>'
  printf '%s\n' '</plist>'
}

ensure_plist() {
  [ "$#" -eq 0 ] || return 1
  local plist_dir plist_tmp plist_serial
  plist_dir=${SERVICE_DEFINITION_PATH%/*}
  /bin/mkdir -p "$plist_dir" "$LOG_DIR" "$WORKSPACE_DIR" || {
    die 'could not create service directories'
    return 1
  }

  plist_serial=$$
  plist_tmp="$plist_dir/.${SERVICE_DEFINITION_PATH##*/}.$plist_serial"
  while [ -e "$plist_tmp" ] || [ -L "$plist_tmp" ]; do
    plist_serial=$((plist_serial + 1))
    plist_tmp="$plist_dir/.${SERVICE_DEFINITION_PATH##*/}.$plist_serial"
  done
  if ! (
    umask 077
    render_plist >"$plist_tmp"
  ); then
    /bin/rm -f -- "$plist_tmp"
    die 'could not render LaunchAgent plist'
    return 1
  fi
  if ! "$PLUTIL_BIN" -lint "$plist_tmp" >/dev/null; then
    /bin/rm -f -- "$plist_tmp"
    die 'LaunchAgent plist failed validation'
    return 1
  fi
  if ! /bin/chmod 0644 "$plist_tmp" || ! /bin/mv -f "$plist_tmp" "$SERVICE_DEFINITION_PATH"; then
    /bin/rm -f -- "$plist_tmp"
    die 'could not publish LaunchAgent plist'
    return 1
  fi
}

unit_escape() {
  [ "$#" -eq 1 ] || return 1
  local escaped_value=$1
  escaped_value=${escaped_value//%/%%}
  printf '%s' "$escaped_value"
}

unit_escape_exec_arg() {
  [ "$#" -eq 1 ] || return 1
  local escaped_value=$1
  escaped_value=${escaped_value//\\/\\\\}
  escaped_value=${escaped_value//\"/\\\"}
  escaped_value=${escaped_value//%/%%}
  printf '%s' "$escaped_value"
}

render_unit() {
  [ "$#" -eq 0 ] || return 1
  local run_exec workdir home_env stdout_path stderr_path
  run_exec=$(unit_escape_exec_arg "$CURRENT_LINK/run") || return 1
  workdir=$(unit_escape "$WORKSPACE_DIR") || return 1
  home_env=$(unit_escape_exec_arg "$HOME") || return 1
  stdout_path=$(unit_escape "$LOG_DIR/stdout.log") || return 1
  stderr_path=$(unit_escape "$LOG_DIR/stderr.log") || return 1
  printf '%s\n' '[Unit]'
  printf '%s\n' 'Description=DeepSeek Harness Web UI service'
  printf '%s\n' ''
  printf '%s\n' '[Service]'
  printf '%s\n' 'Type=simple'
  printf 'ExecStart=/bin/bash "%s"\n' "$run_exec"
  printf 'WorkingDirectory=%s\n' "$workdir"
  printf 'Environment="HOME=%s"\n' "$home_env"
  printf '%s\n' 'Restart=on-failure'
  printf '%s\n' 'RestartSec=10'
  printf '%s\n' 'TimeoutStopSec=15'
  printf 'StandardOutput=append:%s\n' "$stdout_path"
  printf 'StandardError=append:%s\n' "$stderr_path"
  printf '%s\n' ''
  printf '%s\n' '[Install]'
  printf '%s\n' 'WantedBy=default.target'
}

ensure_unit() {
  [ "$#" -eq 0 ] || return 1
  local unit_dir unit_tmp unit_serial
  unit_dir=${SERVICE_DEFINITION_PATH%/*}
  /bin/mkdir -p "$unit_dir" "$LOG_DIR" "$WORKSPACE_DIR" || {
    die 'could not create service directories'
    return 1
  }
  unit_serial=$$
  unit_tmp="$unit_dir/.${SERVICE_DEFINITION_PATH##*/}.$unit_serial"
  while [ -e "$unit_tmp" ] || [ -L "$unit_tmp" ]; do
    unit_serial=$((unit_serial + 1))
    unit_tmp="$unit_dir/.${SERVICE_DEFINITION_PATH##*/}.$unit_serial"
  done
  if ! (
    umask 077
    render_unit >"$unit_tmp"
  ); then
    /bin/rm -f -- "$unit_tmp"
    die 'could not render systemd unit'
    return 1
  fi
  if ! /bin/chmod 0644 "$unit_tmp" || ! /bin/mv -f "$unit_tmp" "$SERVICE_DEFINITION_PATH"; then
    /bin/rm -f -- "$unit_tmp"
    die 'could not publish systemd unit'
    return 1
  fi
  "$SYSTEMCTL_BIN" --user daemon-reload || {
    die 'could not reload systemd user units'
    return 1
  }
}

ensure_service_definition() {
  [ "$#" -eq 0 ] || return 1
  case "$PLATFORM" in
    darwin) ensure_plist ;;
    linux) ensure_unit ;;
    *) return 1 ;;
  esac
}

service_loaded() {
  [ "$#" -eq 0 ] || return 1
  case "$PLATFORM" in
    darwin) "$LAUNCHCTL_BIN" print "$SERVICE_TARGET" >/dev/null 2>&1 ;;
    linux) "$SYSTEMCTL_BIN" --user is-active --quiet "$SERVICE_TARGET" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

launchd_print_pid() {
  [ "$#" -eq 0 ] || return 1
  local print_output print_line parsed_pid pid_count pid_pattern
  print_output=$("$LAUNCHCTL_BIN" print "$SERVICE_TARGET" 2>/dev/null) || return 1
  parsed_pid=
  pid_count=0
  pid_pattern='^[[:space:]]*pid[[:space:]]=[[:space:]]([0-9]+)[[:space:]]*$'
  while IFS= read -r print_line || [ -n "$print_line" ]; do
    if [[ "$print_line" =~ $pid_pattern ]]; then
      parsed_pid=${BASH_REMATCH[1]}
      pid_count=$((pid_count + 1))
    fi
  done <<<"$print_output"
  [ "$pid_count" -eq 1 ] || return 1
  case "$parsed_pid" in
    ''|0|*[!0-9]*) return 1 ;;
  esac
  printf '%s\n' "$parsed_pid"
}

systemd_main_pid() {
  [ "$#" -eq 0 ] || return 1
  local main_pid
  main_pid=$("$SYSTEMCTL_BIN" --user show -p MainPID --value "$SERVICE_TARGET" 2>/dev/null) || return 1
  case "$main_pid" in
    ''|0|*[!0-9]*) return 1 ;;
  esac
  printf '%s\n' "$main_pid"
}

service_pid() {
  [ "$#" -eq 0 ] || return 1
  case "$PLATFORM" in
    darwin) launchd_print_pid ;;
    linux) systemd_main_pid ;;
    *) return 1 ;;
  esac
}

listener_records() {
  case "$PLATFORM" in
    darwin) listener_records_lsof "$@" ;;
    linux) listener_records_ss "$@" ;;
    *) return 1 ;;
  esac
}

listener_records_ss() {
  [ "$#" -le 1 ] || return 1
  local listener_scope ss_output ss_status ss_line local_addr process_field rest
  local pid_extract_pattern emitted_for_line
  listener_scope=${1:-loopback}
  case "$listener_scope" in
    all|loopback) ;;
    *) return 1 ;;
  esac
  ss_output=$("$SS_BIN" -H -tlnp 2>&1)
  ss_status=$?
  [ "$ss_status" -eq 0 ] || return 1
  [ -n "$ss_output" ] || return 0

  pid_extract_pattern='pid=([0-9]+)(.*)$'
  while IFS= read -r ss_line || [ -n "$ss_line" ]; do
    [ -n "$ss_line" ] || continue
    # ss -H -tlnp columns: State Recv-Q Send-Q Local:Port Peer:Port [Process]
    read -r _ _ _ local_addr _ process_field <<EOF2
$ss_line
EOF2
    case "$local_addr" in
      *:3080) ;;
      *) continue ;;
    esac
    if [ "$listener_scope" = loopback ] && [ "$local_addr" != 127.0.0.1:3080 ]; then
      continue
    fi
    emitted_for_line=0
    rest=${process_field:-}
    while [[ "$rest" =~ $pid_extract_pattern ]]; do
      printf '%s|%s\n' "${BASH_REMATCH[1]}" "$local_addr"
      emitted_for_line=1
      rest=${BASH_REMATCH[2]}
    done
    if [ "$emitted_for_line" -eq 0 ]; then
      printf '%s|%s\n' unknown "$local_addr"
    fi
  done <<<"$ss_output"
}

listener_records_lsof() {
  [ "$#" -le 1 ] || return 1
  local listener_scope selector lsof_output lsof_status field_line current_pid
  listener_scope=${1:-loopback}
  case "$listener_scope" in
    all) selector=-iTCP:3080 ;;
    loopback) selector=-iTCP@127.0.0.1:3080 ;;
    *) return 1 ;;
  esac

  lsof_output=$("$LSOF_BIN" -nP -a "$selector" -sTCP:LISTEN -Fpn 2>&1)
  lsof_status=$?
  if [ "$lsof_status" -ne 0 ]; then
    if [ "$lsof_status" -eq 1 ] && [ -z "$lsof_output" ]; then
      return 0
    fi
    return 1
  fi
  [ -n "$lsof_output" ] || return 0

  current_pid=
  while IFS= read -r field_line || [ -n "$field_line" ]; do
    case "$field_line" in
      p*)
        current_pid=${field_line#p}
        case "$current_pid" in
          ''|0|*[!0-9]*) return 1 ;;
        esac
        ;;
      n*)
        [ -n "$current_pid" ] || return 1
        printf '%s|%s\n' "$current_pid" "${field_line#n}"
        ;;
    esac
  done <<<"$lsof_output"
}

listener_pids() {
  [ "$#" -le 1 ] || return 1
  local listener_scope records record listener_pid seen_pids
  listener_scope=${1:-loopback}
  records=$(listener_records "$listener_scope") || return 1
  [ -n "$records" ] || return 0

  seen_pids=' '
  while IFS= read -r record || [ -n "$record" ]; do
    listener_pid=${record%%|*}
    case "$seen_pids" in
      *" $listener_pid "*) ;;
      *)
        printf '%s\n' "$listener_pid"
        seen_pids="$seen_pids$listener_pid "
        ;;
    esac
  done <<<"$records"
}

listener_conflict() {
  [ "$#" -eq 1 ] || return 2
  local expected_pid records record listener_pid listener_name
  expected_pid=$1
  records=$(listener_records all) || return 2
  [ -n "$records" ] || return 1

  while IFS= read -r record || [ -n "$record" ]; do
    listener_pid=${record%%|*}
    listener_name=${record#*|}
    if [ -z "$expected_pid" ] || [ "$listener_pid" != "$expected_pid" ] ||
      [ "$listener_name" != 127.0.0.1:3080 ]; then
      return 0
    fi
  done <<<"$records"
  return 1
}

pid_is_listening() {
  [ "$#" -eq 1 ] || return 1
  local wanted_pid active_pids active_pid
  wanted_pid=$1
  [ -n "$wanted_pid" ] || return 1
  active_pids=$(listener_pids all) || return 2
  while IFS= read -r active_pid || [ -n "$active_pid" ]; do
    [ "$active_pid" = "$wanted_pid" ] && return 0
  done <<<"$active_pids"
  return 1
}

health_state() {
  [ "$#" -eq 0 ] || return 1
  local loaded_state supervisor_pid conflict_status loopback_pids loopback_pid loopback_count
  loaded_state=0
  service_loaded && loaded_state=1
  supervisor_pid=$(service_pid 2>/dev/null) || supervisor_pid=

  listener_conflict "$supervisor_pid"
  conflict_status=$?
  if [ "$conflict_status" -ne 1 ]; then
    printf 'conflict\n'
    return 1
  fi
  if [ "$loaded_state" -eq 0 ]; then
    printf 'unloaded\n'
    return 1
  fi
  if [ -z "$supervisor_pid" ]; then
    printf 'starting\n'
    return 1
  fi

  loopback_pids=$(listener_pids loopback) || {
    printf 'conflict\n'
    return 1
  }
  if [ -z "$loopback_pids" ]; then
    printf 'starting\n'
    return 1
  fi
  loopback_count=0
  loopback_pid=
  while IFS= read -r loopback_pid_line || [ -n "$loopback_pid_line" ]; do
    [ -n "$loopback_pid_line" ] || continue
    loopback_pid=$loopback_pid_line
    loopback_count=$((loopback_count + 1))
  done <<<"$loopback_pids"
  if [ "$loopback_count" -ne 1 ] || [ "$loopback_pid" != "$supervisor_pid" ]; then
    printf 'conflict\n'
    return 1
  fi

  if "$CURL_BIN" --fail --silent --show-error --max-time 2 --output /dev/null \
    http://127.0.0.1:3080 >/dev/null; then
    printf 'healthy\n'
    return 0
  fi
  printf 'unhealthy\n'
  return 1
}

wait_for_health() {
  [ "$#" -eq 0 ] || return 1
  local wait_attempt wait_started wait_deadline
  wait_attempt=0
  wait_started=$SECONDS
  wait_deadline=$((wait_started + WAIT_TIMEOUT_SECONDS))
  while [ "$wait_attempt" -lt "$WAIT_ATTEMPTS" ]; do
    [ "$SECONDS" -lt "$wait_deadline" ] || return 1
    health_state >/dev/null && return 0
    wait_attempt=$((wait_attempt + 1))
    [ "$wait_attempt" -lt "$WAIT_ATTEMPTS" ] || return 1
    [ "$SECONDS" -lt "$wait_deadline" ] || return 1
    /bin/sleep "$WAIT_INTERVAL"
  done
  return 1
}

wait_for_service_absence() {
  [ "$#" -eq 1 ] || return 1
  local old_pid wait_attempt job_present listener_present
  old_pid=$1
  wait_attempt=0
  while [ "$wait_attempt" -lt "$WAIT_ATTEMPTS" ]; do
    job_present=0
    listener_present=0
    service_loaded && job_present=1
    if [ -n "$old_pid" ]; then
      pid_is_listening "$old_pid"
      case "$?" in
        0) listener_present=1 ;;
        1) ;;
        *) return 1 ;;
      esac
    fi
    if [ "$job_present" -eq 0 ] && [ "$listener_present" -eq 0 ]; then
      return 0
    fi
    wait_attempt=$((wait_attempt + 1))
    if [ "$wait_attempt" -lt "$WAIT_ATTEMPTS" ]; then
      /bin/sleep "$WAIT_INTERVAL"
    fi
  done
  return 1
}

wait_for_restarted_health() {
  [ "$#" -eq 1 ] || return 1
  local old_pid wait_attempt new_pid
  old_pid=$1
  wait_attempt=0
  while [ "$wait_attempt" -lt "$WAIT_ATTEMPTS" ]; do
    new_pid=$(service_pid 2>/dev/null) || new_pid=
    if [ -n "$new_pid" ] && [ "$new_pid" != "$old_pid" ] &&
      ! pid_is_listening "$old_pid" && health_state >/dev/null; then
      return 0
    fi
    wait_attempt=$((wait_attempt + 1))
    if [ "$wait_attempt" -lt "$WAIT_ATTEMPTS" ]; then
      /bin/sleep "$WAIT_INTERVAL"
    fi
  done
  return 1
}

supervisor_load() {
  [ "$#" -eq 0 ] || return 1
  case "$PLATFORM" in
    darwin) "$LAUNCHCTL_BIN" bootstrap "${SERVICE_TARGET%/*}" "$SERVICE_DEFINITION_PATH" ;;
    linux) "$SYSTEMCTL_BIN" --user enable --now "$SERVICE_TARGET" ;;
    *) return 1 ;;
  esac
}

supervisor_kickstart() {
  [ "$#" -eq 0 ] || return 1
  case "$PLATFORM" in
    darwin) "$LAUNCHCTL_BIN" kickstart "$SERVICE_TARGET" ;;
    linux) "$SYSTEMCTL_BIN" --user restart "$SERVICE_TARGET" ;;
    *) return 1 ;;
  esac
}

supervisor_graceful_restart() {
  [ "$#" -eq 0 ] || return 1
  case "$PLATFORM" in
    darwin) "$LAUNCHCTL_BIN" kill SIGTERM "$SERVICE_TARGET" ;;
    linux) "$SYSTEMCTL_BIN" --user restart "$SERVICE_TARGET" ;;
    *) return 1 ;;
  esac
}

supervisor_unload() {
  [ "$#" -eq 0 ] || return 1
  case "$PLATFORM" in
    darwin) "$LAUNCHCTL_BIN" bootout "$SERVICE_TARGET" ;;
    linux) "$SYSTEMCTL_BIN" --user stop "$SERVICE_TARGET" ;;
    *) return 1 ;;
  esac
}

bootstrap_service() {
  [ "$#" -eq 0 ] || return 1
  supervisor_load || {
    die 'could not load the service'
    return 1
  }
  wait_for_health || {
    die 'the service did not become healthy'
    return 1
  }
}

start_service() {
  [ "$#" -eq 0 ] || return 1
  local current_health current_pid
  current_health=$(health_state)
  case "$current_health" in
    conflict)
      die 'port 3080 is owned by another listener'
      return 1
      ;;
  esac
  ensure_service_definition || return 1
  case "$current_health" in
    healthy) return 0 ;;
    unloaded)
      bootstrap_service
      ;;
    starting)
      current_pid=$(service_pid 2>/dev/null) || current_pid=
      if [ -z "$current_pid" ]; then
        listener_conflict ''
        case "$?" in
          1) ;;
          *)
            die 'port 3080 is owned by another listener'
            return 1
            ;;
        esac
        supervisor_kickstart || {
          die 'could not kickstart the service'
          return 1
        }
        wait_for_health || {
          die 'the service did not become healthy'
          return 1
        }
      elif wait_for_health; then
        return 0
      else
        restart_service
      fi
      ;;
    unhealthy) restart_service ;;
    *)
      die 'unknown service health state'
      return 1
      ;;
  esac
}

stop_service() {
  [ "$#" -eq 0 ] || return 1
  local old_pid
  service_loaded || return 0
  old_pid=$(service_pid 2>/dev/null) || old_pid=
  supervisor_unload || {
    die 'could not unload the service'
    return 1
  }
  wait_for_service_absence "$old_pid" || {
    die 'the service did not stop cleanly'
    return 1
  }
}

restart_service() {
  [ "$#" -eq 0 ] || return 1
  local restart_health old_pid
  restart_health=$(health_state)
  case "$restart_health" in
    conflict)
      die 'port 3080 is owned by another listener'
      return 1
      ;;
  esac
  ensure_service_definition || return 1
  [ "$restart_health" != unloaded ] || {
    bootstrap_service
    return $?
  }

  old_pid=$(service_pid 2>/dev/null) || old_pid=
  if [ -n "$old_pid" ]; then
    listener_conflict "$old_pid"
    case "$?" in
      1) ;;
      *)
        die 'port 3080 is owned by another listener'
        return 1
        ;;
    esac
    if supervisor_graceful_restart &&
      wait_for_restarted_health "$old_pid"; then
      return 0
    fi
  fi

  supervisor_unload || {
    die 'could not unload the service during restart'
    return 1
  }
  wait_for_service_absence "$old_pid" || {
    die 'the old service instance did not stop'
    return 1
  }
  bootstrap_service
}

node_version_supported() {
  [ "$#" -eq 1 ] || return 1

  version=$1
  case "$version" in
    *.*.*) ;;
    *) return 1 ;;
  esac

  major=${version%%.*}
  remainder=${version#*.}
  minor=${remainder%%.*}
  patch=${remainder#*.}

  case "$patch" in
    *.*) return 1 ;;
  esac
  case "$major" in
    ''|*[!0-9]*) return 1 ;;
  esac
  case "$minor" in
    ''|*[!0-9]*) return 1 ;;
  esac
  case "$patch" in
    ''|*[!0-9]*) return 1 ;;
  esac

  while [ "${major#0}" != "$major" ]; do
    major=${major#0}
  done
  while [ "${minor#0}" != "$minor" ]; do
    minor=${minor#0}
  done
  major=${major:-0}
  minor=${minor:-0}

  case ${#major} in
    1) return 1 ;;
    2)
      case "$major" in
        22)
          case ${#minor} in
            1) return 1 ;;
            2)
              case "$minor" in
                1[9]|[2-9][0-9]) return 0 ;;
                *) return 1 ;;
              esac
              ;;
            *) return 0 ;;
          esac
          ;;
        23) return 1 ;;
        2[4-9]|[3-9][0-9]) return 0 ;;
        *) return 1 ;;
      esac
      ;;
    *) return 0 ;;
  esac
}

validate_release_id() {
  [ "$#" -eq 1 ] || return 1
  release_id_pattern='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?-[0-9]+-[0-9]+$'
  [[ "$1" =~ $release_id_pattern ]]
}

cli_relative_safe() {
  [ "$#" -eq 1 ] || return 1
  case "$1" in
    ''|/*|.|..|./*|../*|*/./*|*/../*|*/.|*/..|*//* ) return 1 ;;
  esac
  return 0
}

read_manifest() {
  [ "$#" -eq 1 ] || {
    die 'read_manifest requires a path'
    return 1
  }
  manifest_path=$1
  [ -r "$manifest_path" ] || {
    die "cannot read manifest: $manifest_path"
    return 1
  }

  manifest_schema=
  manifest_dsh_version=
  manifest_node_bin=
  manifest_cli_relative=
  manifest_installed_at=
  seen_schema=0
  seen_dsh_version=0
  seen_node_bin=0
  seen_cli_relative=0
  seen_installed_at=0

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      *=*) ;;
      *)
        die "malformed manifest line: $line"
        return 1
        ;;
    esac
    key=${line%%=*}
    value=${line#*=}
    case "$key" in
      SCHEMA_VERSION)
        [ "$seen_schema" -eq 0 ] || {
          die 'duplicate manifest key: SCHEMA_VERSION'
          return 1
        }
        seen_schema=1
        manifest_schema=$value
        ;;
      DSH_VERSION)
        [ "$seen_dsh_version" -eq 0 ] || {
          die 'duplicate manifest key: DSH_VERSION'
          return 1
        }
        seen_dsh_version=1
        manifest_dsh_version=$value
        ;;
      NODE_BIN)
        [ "$seen_node_bin" -eq 0 ] || {
          die 'duplicate manifest key: NODE_BIN'
          return 1
        }
        seen_node_bin=1
        manifest_node_bin=$value
        ;;
      CLI_RELATIVE)
        [ "$seen_cli_relative" -eq 0 ] || {
          die 'duplicate manifest key: CLI_RELATIVE'
          return 1
        }
        seen_cli_relative=1
        manifest_cli_relative=$value
        ;;
      INSTALLED_AT)
        [ "$seen_installed_at" -eq 0 ] || {
          die 'duplicate manifest key: INSTALLED_AT'
          return 1
        }
        seen_installed_at=1
        manifest_installed_at=$value
        ;;
      *)
        die "unknown manifest key: $key"
        return 1
        ;;
    esac
  done <"$manifest_path"

  [ "$seen_schema" -eq 1 ] &&
    [ "$seen_dsh_version" -eq 1 ] &&
    [ "$seen_node_bin" -eq 1 ] &&
    [ "$seen_cli_relative" -eq 1 ] &&
    [ "$seen_installed_at" -eq 1 ] || {
      die 'manifest is missing required keys'
      return 1
    }
  [ "$manifest_schema" = 1 ] || {
    die 'unsupported manifest schema'
    return 1
  }
  [ -n "$manifest_dsh_version" ] || {
    die 'manifest DSH_VERSION is empty'
    return 1
  }
  case "$manifest_node_bin" in
    /*) ;;
    *)
      die 'manifest NODE_BIN must be absolute'
      return 1
      ;;
  esac
  [ -f "$manifest_node_bin" ] && [ -x "$manifest_node_bin" ] || {
    die 'manifest NODE_BIN must be executable'
    return 1
  }
  cli_relative_safe "$manifest_cli_relative" || {
    die 'manifest CLI_RELATIVE is unsafe'
    return 1
  }
  case "$manifest_installed_at" in
    ''|*[!0-9]*)
      die 'manifest INSTALLED_AT must be numeric'
      return 1
      ;;
  esac

  MANIFEST_SCHEMA_VERSION=$manifest_schema
  MANIFEST_DSH_VERSION=$manifest_dsh_version
  MANIFEST_NODE_BIN=$manifest_node_bin
  MANIFEST_CLI_RELATIVE=$manifest_cli_relative
  MANIFEST_INSTALLED_AT=$manifest_installed_at
}

read_activation() {
  activation_path=${1:-$ACTIVATION_FILE}
  [ "$#" -le 1 ] || {
    die 'read_activation accepts at most one path'
    return 1
  }
  [ -f "$activation_path" ] && [ ! -L "$activation_path" ] && [ -r "$activation_path" ] || {
    die "cannot read activation: $activation_path"
    return 1
  }

  activation_schema=
  activation_old_release=
  activation_candidate_release=
  seen_schema=0
  seen_old_release=0
  seen_candidate_release=0

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      *=*) ;;
      *)
        die "malformed activation line: $line"
        return 1
        ;;
    esac
    key=${line%%=*}
    value=${line#*=}
    case "$key" in
      SCHEMA_VERSION)
        [ "$seen_schema" -eq 0 ] || {
          die 'duplicate activation key: SCHEMA_VERSION'
          return 1
        }
        seen_schema=1
        activation_schema=$value
        ;;
      OLD_RELEASE)
        [ "$seen_old_release" -eq 0 ] || {
          die 'duplicate activation key: OLD_RELEASE'
          return 1
        }
        seen_old_release=1
        activation_old_release=$value
        ;;
      CANDIDATE_RELEASE)
        [ "$seen_candidate_release" -eq 0 ] || {
          die 'duplicate activation key: CANDIDATE_RELEASE'
          return 1
        }
        seen_candidate_release=1
        activation_candidate_release=$value
        ;;
      *)
        die "unknown activation key: $key"
        return 1
        ;;
    esac
  done <"$activation_path"

  [ "$seen_schema" -eq 1 ] &&
    [ "$seen_old_release" -eq 1 ] &&
    [ "$seen_candidate_release" -eq 1 ] || {
      die 'activation is missing required keys'
      return 1
    }
  [ "$activation_schema" = 1 ] || {
    die 'unsupported activation schema'
    return 1
  }
  if [ "$activation_old_release" != NONE ]; then
    validate_release_id "$activation_old_release" || {
      die 'activation OLD_RELEASE is invalid'
      return 1
    }
  fi
  validate_release_id "$activation_candidate_release" || {
    die 'activation CANDIDATE_RELEASE is invalid'
    return 1
  }

  ACTIVATION_SCHEMA_VERSION=$activation_schema
  ACTIVATION_OLD_RELEASE=$activation_old_release
  ACTIVATION_CANDIDATE_RELEASE=$activation_candidate_release
}

write_activation() {
  [ "$#" -eq 2 ] || {
    die 'write_activation requires old and candidate release IDs'
    return 1
  }
  local old_release candidate_release activation_tmp
  old_release=$1
  candidate_release=$2
  activation_tmp="$ACTIVATION_FILE.tmp.$$"

  [ -d "$DSH_SERVICE_ROOT" ] && [ ! -L "$DSH_SERVICE_ROOT" ] || {
    die 'manager root is unavailable for activation journal'
    return 1
  }
  if [ -L "$ACTIVATION_FILE" ] ||
    { [ -e "$ACTIVATION_FILE" ] && [ ! -f "$ACTIVATION_FILE" ]; }; then
    die 'activation journal path is unsafe'
    return 1
  fi
  if [ -e "$activation_tmp" ] || [ -L "$activation_tmp" ]; then
    die 'activation journal temporary path already exists'
    return 1
  fi

  if ! (
    umask 077
    {
      printf 'SCHEMA_VERSION=1\n'
      printf 'OLD_RELEASE=%s\n' "$old_release"
      printf 'CANDIDATE_RELEASE=%s\n' "$candidate_release"
    } >"$activation_tmp"
  ); then
    [ ! -L "$activation_tmp" ] && /bin/rm -f -- "$activation_tmp"
    die 'could not write activation journal'
    return 1
  fi
  if ! read_activation "$activation_tmp" ||
    [ "$ACTIVATION_OLD_RELEASE" != "$old_release" ] ||
    [ "$ACTIVATION_CANDIDATE_RELEASE" != "$candidate_release" ]; then
    /bin/rm -f -- "$activation_tmp"
    die 'activation journal failed validation'
    return 1
  fi
  if ! /bin/mv -f "$activation_tmp" "$ACTIVATION_FILE"; then
    /bin/rm -f -- "$activation_tmp"
    die 'could not publish activation journal'
    return 1
  fi
}

release_link_id() {
  [ "$#" -eq 1 ] || return 1
  local link_path link_target link_id
  link_path=$1
  case "$link_path" in
    "$CURRENT_LINK"|"$PREVIOUS_LINK") ;;
    *) return 1 ;;
  esac
  [ -L "$link_path" ] || return 1
  link_target=$(/usr/bin/readlink "$link_path") || return 1
  case "$link_target" in
    releases/*) link_id=${link_target#releases/} ;;
    *) return 1 ;;
  esac
  validate_release_id "$link_id" || return 1
  release_dir_is_owned "$RELEASES_DIR/$link_id" || return 1
  printf '%s\n' "$link_id"
}

previous_release_id() {
  [ "$#" -eq 0 ] || return 1
  release_link_id "$PREVIOUS_LINK"
}

remove_activation_journal() {
  [ "$#" -eq 0 ] || return 1
  [ -f "$ACTIVATION_FILE" ] && [ ! -L "$ACTIVATION_FILE" ] || {
    die 'activation journal is unavailable for removal'
    return 1
  }
  /bin/rm -f -- "$ACTIVATION_FILE" || {
    die 'could not remove activation journal'
    return 1
  }
}

remove_owned_release() {
  [ "$#" -eq 1 ] || return 1
  local release_id release_path
  release_id=$1
  validate_release_id "$release_id" || return 1
  release_path="$RELEASES_DIR/$release_id"
  release_dir_is_owned "$release_path" || return 1
  /bin/rm -rf -- "$release_path"
}

prune_releases() {
  [ "$#" -eq 0 ] || return 1
  local current_id previous_id child child_id child_physical child_parent
  [ -n "${RELEASES_DIR:-}" ] || {
    die 'releases directory must not be empty'
    return 1
  }
  release_root_is_owned || {
    die 'releases directory is not manager-owned'
    return 1
  }

  current_id=
  if [ -e "$CURRENT_LINK" ] || [ -L "$CURRENT_LINK" ]; then
    current_id=$(current_release_id) || {
      die 'current release link is invalid'
      return 1
    }
  fi
  previous_id=
  if [ -e "$PREVIOUS_LINK" ] || [ -L "$PREVIOUS_LINK" ]; then
    previous_id=$(previous_release_id) || {
      die 'previous release link is invalid'
      return 1
    }
  fi

  for child in "$RELEASES_DIR"/*; do
    [ -e "$child" ] || [ -L "$child" ] || continue
    child_id=${child##*/}
    validate_release_id "$child_id" || continue
    [ -d "$child" ] && [ ! -L "$child" ] || continue
    [ "$child_id" != "$current_id" ] && [ "$child_id" != "$previous_id" ] || continue
    child_physical=$(CDPATH='' cd -P -- "$child" && pwd) || return 1
    child_parent=$(CDPATH='' cd -P -- "$child_physical/.." && pwd) || return 1
    [ "$child_parent" = "$owned_releases_physical" ] || {
      die 'release candidate is outside the releases directory'
      return 1
    }
    /bin/rm -rf -- "$child" || return 1
  done
}

rollback_activation() {
  [ "$#" -eq 2 ] || return 1
  local old_release candidate_release linked_release
  old_release=$1
  candidate_release=$2
  validate_release_id "$candidate_release" || return 1

  if [ "$old_release" = NONE ]; then
    stop_service || return 1
    service_loaded && {
      die 'LaunchAgent is still loaded after failed first install'
      return 1
    }
    linked_release=$(current_release_id) || return 1
    [ "$linked_release" = "$candidate_release" ] || return 1
    /bin/rm -f -- "$CURRENT_LINK" || return 1
    remove_owned_release "$candidate_release" || return 1
    remove_activation_journal || return 1
    return 0
  fi

  validate_release_id "$old_release" || return 1
  atomic_release_link "$CURRENT_LINK" "$old_release" || return 1
  restart_service || return 1
  wait_for_health || return 1
  remove_activation_journal || return 1
  remove_owned_release "$candidate_release" || return 1
  prune_releases
}

resume_activation() {
  [ "$#" -eq 3 ] || return 1
  local old_release candidate_release current_state
  old_release=$1
  candidate_release=$2
  current_state=$3

  if [ "$old_release" != NONE ]; then
    atomic_release_link "$PREVIOUS_LINK" "$old_release" || return 1
  fi
  if [ "$current_state" != "$candidate_release" ]; then
    atomic_release_link "$CURRENT_LINK" "$candidate_release" || return 1
  fi

  if [ "$old_release" = NONE ] && [ "$current_state" = NONE ]; then
    if ! start_service || ! wait_for_health; then
      rollback_activation "$old_release" "$candidate_release" || :
      return 1
    fi
  else
    if ! restart_service || ! wait_for_health; then
      rollback_activation "$old_release" "$candidate_release" || :
      return 1
    fi
  fi

  remove_activation_journal || return 1
  prune_releases
}

activate_release() {
  [ "$#" -eq 1 ] || return 1
  local candidate_release old_release
  candidate_release=$1
  validate_release_id "$candidate_release" || {
    die 'candidate release ID is invalid'
    return 1
  }
  validate_release "$RELEASES_DIR/$candidate_release" || return 1
  if [ -e "$ACTIVATION_FILE" ] || [ -L "$ACTIVATION_FILE" ]; then
    die 'an activation journal already exists'
    return 1
  fi

  old_release=NONE
  if [ -e "$CURRENT_LINK" ] || [ -L "$CURRENT_LINK" ]; then
    old_release=$(current_release_id) || {
      die 'current release link is invalid before activation'
      return 1
    }
    validate_release "$RELEASES_DIR/$old_release" || return 1
  fi

  write_activation "$old_release" "$candidate_release" || return 1
  resume_activation "$old_release" "$candidate_release" "$old_release"
}

remove_incomplete_staging_releases() {
  [ "$#" -eq 0 ] || return 1
  local staging_path staging_name staging_name_pattern
  if [ ! -e "$RELEASES_DIR" ] && [ ! -L "$RELEASES_DIR" ]; then
    return 0
  fi
  release_root_is_owned || {
    die 'releases directory is not manager-owned during recovery'
    return 1
  }

  staging_name_pattern='^\.staging-[0-9]+-[0-9]+$'
  for staging_path in "$RELEASES_DIR"/.staging-*; do
    [ -e "$staging_path" ] || [ -L "$staging_path" ] || continue
    staging_name=${staging_path##*/}
    [[ "$staging_name" =~ $staging_name_pattern ]] || continue
    [ -d "$staging_path" ] && [ ! -L "$staging_path" ] || continue
    release_dir_is_owned "$staging_path" || {
      die 'staging directory is not manager-owned during recovery'
      return 1
    }
    if [ -f "$staging_path/.complete" ] && [ ! -L "$staging_path/.complete" ]; then
      continue
    fi
    /bin/rm -rf -- "$staging_path" || {
      die 'could not remove incomplete staging directory'
      return 1
    }
  done
}

recover_without_activation_journal() {
  [ "$#" -eq 0 ] || return 1
  local current_present current_id current_complete
  local previous_present previous_id previous_complete

  if [ ! -e "$RELEASES_DIR" ] && [ ! -L "$RELEASES_DIR" ]; then
    if [ -e "$CURRENT_LINK" ] || [ -L "$CURRENT_LINK" ] ||
      [ -e "$PREVIOUS_LINK" ] || [ -L "$PREVIOUS_LINK" ]; then
      die 'release link exists without a releases directory'
      return 1
    fi
    return 0
  fi
  release_root_is_owned || {
    die 'releases directory is not manager-owned during recovery'
    return 1
  }

  current_present=0
  current_id=
  current_complete=0
  if [ -e "$CURRENT_LINK" ] || [ -L "$CURRENT_LINK" ]; then
    current_present=1
    current_id=$(release_link_id "$CURRENT_LINK") || {
      die 'current release link is invalid during recovery'
      return 1
    }
    if validate_release "$RELEASES_DIR/$current_id" >/dev/null 2>&1; then
      current_complete=1
    fi
  fi

  previous_present=0
  previous_id=
  previous_complete=0
  if [ -e "$PREVIOUS_LINK" ] || [ -L "$PREVIOUS_LINK" ]; then
    previous_present=1
    previous_id=$(release_link_id "$PREVIOUS_LINK") || {
      die 'previous release link is invalid during recovery'
      return 1
    }
    if validate_release "$RELEASES_DIR/$previous_id" >/dev/null 2>&1; then
      previous_complete=1
    fi
  fi

  if [ "$current_complete" -eq 1 ]; then
    remove_incomplete_staging_releases
    return $?
  fi
  if [ "$previous_complete" -eq 1 ]; then
    atomic_release_link "$CURRENT_LINK" "$previous_id" || return 1
    remove_incomplete_staging_releases
    return $?
  fi
  if [ "$current_present" -eq 1 ]; then
    die 'current release is incomplete and no complete previous release is available'
    return 1
  fi
  if [ "$previous_present" -eq 1 ]; then
    die 'previous release is incomplete and cannot restore current'
    return 1
  fi
  remove_incomplete_staging_releases
}

recover_activation() {
  [ "$#" -eq 0 ] || return 1
  local old_release candidate_release current_state
  if [ ! -e "$ACTIVATION_FILE" ] && [ ! -L "$ACTIVATION_FILE" ]; then
    recover_without_activation_journal
    return $?
  fi
  read_activation || return 1
  old_release=$ACTIVATION_OLD_RELEASE
  candidate_release=$ACTIVATION_CANDIDATE_RELEASE

  validate_release "$RELEASES_DIR/$candidate_release" || return 1
  if [ "$old_release" != NONE ]; then
    validate_release "$RELEASES_DIR/$old_release" || return 1
  fi

  current_state=NONE
  if [ -e "$CURRENT_LINK" ] || [ -L "$CURRENT_LINK" ]; then
    current_state=$(current_release_id) || {
      die 'current release link is invalid during recovery'
      return 1
    }
  fi

  if [ "$old_release" = NONE ]; then
    case "$current_state" in
      NONE|"$candidate_release") ;;
      *)
        die 'current release is unrelated to activation journal'
        return 1
        ;;
    esac
  else
    case "$current_state" in
      "$old_release"|"$candidate_release") ;;
      *)
        die 'current release is unrelated to activation journal'
        return 1
        ;;
    esac
  fi

  resume_activation "$old_release" "$candidate_release" "$current_state"
}

preflight_common() {
  local expected_uname
  case "$PLATFORM" in
    darwin) expected_uname=Darwin ;;
    linux) expected_uname=Linux ;;
    *)
      die 'unsupported platform'
      return 1
      ;;
  esac
  if [ "${DSH_SERVICE_TESTING:-0}" = 1 ] && [ -n "${DSH_SERVICE_PLATFORM:-}" ]; then
    :
  else
    [ "$(/usr/bin/uname -s 2>/dev/null)" = "$expected_uname" ] || {
      die "$expected_uname is required"
      return 1
    }
  fi
  case "$HOME" in
    '')
      die 'HOME must not be empty'
      return 1
      ;;
    /*) ;;
    *)
      die 'HOME must be absolute'
      return 1
      ;;
  esac
  case "$HOME" in
    *"
"*)
      die 'HOME must not contain a newline'
      return 1
      ;;
  esac
  case "$PLATFORM" in
    darwin)
      case "$LAUNCHCTL_BIN" in
        /*) ;;
        *)
          die 'launchctl path must be absolute'
          return 1
          ;;
      esac
      [ -x "$LAUNCHCTL_BIN" ] || {
        die 'launchctl is unavailable'
        return 1
      }
      "$LAUNCHCTL_BIN" print "gui/$(/usr/bin/id -u)" >/dev/null 2>&1 || {
        die 'launchd GUI domain is unavailable'
        return 1
      }
      ;;
    linux)
      case "$SYSTEMCTL_BIN" in
        /*) ;;
        *)
          die 'systemctl path must be absolute'
          return 1
          ;;
      esac
      [ -f "$SYSTEMCTL_BIN" ] && [ -x "$SYSTEMCTL_BIN" ] || {
        die 'systemctl is unavailable'
        return 1
      }
      ;;
  esac

  for command_path in "$@"; do
    case "$command_path" in
      /*) ;;
      *)
        die "command path must be absolute: $command_path"
        return 1
        ;;
    esac
    [ -f "$command_path" ] && [ -x "$command_path" ] || {
      die "required command is unavailable: $command_path"
      return 1
    }
  done
}

resolve_external_command() {
  [ "$#" -eq 1 ] || return 1
  command_name=$1
  command_kind=$(type -t "$command_name" 2>/dev/null) || return 1
  [ "$command_kind" = file ] || return 1
  command_path=$(command -v "$command_name" 2>/dev/null) || return 1
  case "$command_path" in
    /*) ;;
    *) return 1 ;;
  esac
  [ -x "$command_path" ] || return 1
  printf '%s\n' "$command_path"
}

resolve_node_and_npm() {
  [ "$#" -eq 0 ] || {
    die 'resolve_node_and_npm accepts no arguments'
    return 1
  }
  resolved_node=$(resolve_external_command node) || {
    die 'node must resolve to an absolute executable, not an alias or function'
    return 1
  }
  resolved_npm=$(resolve_external_command npm) || {
    die 'npm must resolve to an absolute executable, not an alias or function'
    return 1
  }
  raw_node_version=$("$resolved_node" --version 2>/dev/null) || {
    die 'could not read the Node.js version'
    return 1
  }
  resolved_node_version=${raw_node_version#v}
  node_version_supported "$resolved_node_version" || {
    die "unsupported Node.js version: $raw_node_version"
    return 1
  }

  NODE_BIN=$resolved_node
  NPM_BIN=$resolved_npm
  NODE_VERSION=$resolved_node_version
}

preflight_install() {
  preflight_manager_destinations || return 1
  if [ "$PLATFORM" = darwin ]; then
    preflight_common "$PLUTIL_BIN" "$LISTENER_BIN" "$CURL_BIN" "$OPEN_BIN" || return 1
  else
    preflight_common "$LISTENER_BIN" "$CURL_BIN" || return 1
  fi
  resolve_node_and_npm || return 1
  resolve_manager_sources
}

validate_optional_install_directory() {
  [ "$#" -eq 1 ] || return 1
  local install_directory
  install_directory=$1
  if [ -e "$install_directory" ] || [ -L "$install_directory" ]; then
    [ -d "$install_directory" ] && [ ! -L "$install_directory" ] || {
      die "install parent must be a physical directory: $install_directory"
      return 1
    }
  fi
}

validate_optional_manager_file() {
  [ "$#" -eq 1 ] || return 1
  local manager_file
  manager_file=$1
  if [ -e "$manager_file" ] || [ -L "$manager_file" ]; then
    [ -f "$manager_file" ] && [ ! -L "$manager_file" ] || {
      die "manager destination must be a physical regular file: $manager_file"
      return 1
    }
  fi
}

preflight_manager_destinations() {
  [ "$#" -eq 0 ] || return 1
  validate_optional_install_directory "$HOME" || return 1
  validate_optional_install_directory "$HOME/.local" || return 1
  validate_optional_install_directory "${CLI_DEST%/*}" || return 1
  if [ -n "$ROOT_GRANDPARENT_DIR" ]; then
    validate_optional_install_directory "$ROOT_GRANDPARENT_DIR" || return 1
    validate_optional_install_directory "$ROOT_PARENT_DIR" || return 1
  else
    validate_optional_install_directory "${XDG_DATA_HOME:-}" || return 1
  fi
  validate_optional_install_directory "$DSH_SERVICE_ROOT" || return 1
  validate_optional_install_directory "${RUNNER_TEMPLATE%/*}" || return 1
  validate_optional_manager_file "$CLI_DEST" || return 1
  validate_optional_manager_file "$RUNNER_TEMPLATE"
}

resolve_manager_sources() {
  [ "$#" -eq 0 ] || return 1
  local invoked_path source_dir source_name checkout_runner runner_parent
  invoked_path=$MANAGER_SCRIPT_PATH
  source_dir=$(CDPATH='' cd -P -- "$(dirname -- "$invoked_path")" && pwd) || {
    die 'could not resolve the manager command source'
    return 1
  }
  source_name=$(basename -- "$invoked_path") || return 1
  MANAGER_CLI_SOURCE="$source_dir/$source_name"
  [ -f "$MANAGER_CLI_SOURCE" ] && [ ! -L "$MANAGER_CLI_SOURCE" ] || {
    die 'manager command source is unavailable'
    return 1
  }

  checkout_runner="$source_dir/../libexec/dsh-service-run"
  if [ -f "$checkout_runner" ] && [ ! -L "$checkout_runner" ]; then
    runner_parent=$(CDPATH='' cd -P -- "$(dirname -- "$checkout_runner")" && pwd) || return 1
    MANAGER_RUNNER_SOURCE="$runner_parent/$(basename -- "$checkout_runner")"
  elif [ -f "$RUNNER_TEMPLATE" ] && [ ! -L "$RUNNER_TEMPLATE" ]; then
    MANAGER_RUNNER_SOURCE=$RUNNER_TEMPLATE
  else
    die 'manager runner source is unavailable'
    return 1
  fi

  /bin/bash -n "$MANAGER_CLI_SOURCE" "$MANAGER_RUNNER_SOURCE" || {
    die 'manager source failed syntax validation'
    return 1
  }
  if { [ -e "$DSH_SERVICE_ROOT" ] || [ -L "$DSH_SERVICE_ROOT" ]; } &&
    { [ ! -d "$DSH_SERVICE_ROOT" ] || [ -L "$DSH_SERVICE_ROOT" ]; }; then
    die 'manager root must be a physical directory'
    return 1
  fi
  if { [ -e "${CLI_DEST%/*}" ] || [ -L "${CLI_DEST%/*}" ]; } &&
    { [ ! -d "${CLI_DEST%/*}" ] || [ -L "${CLI_DEST%/*}" ]; }; then
    die 'manager command directory must be a physical directory'
    return 1
  fi
}

resolve_latest_version() {
  [ "$#" -eq 0 ] || {
    die 'resolve_latest_version accepts no arguments'
    return 1
  }
  [ -n "${NPM_BIN:-}" ] && [ -f "$NPM_BIN" ] && [ -x "$NPM_BIN" ] || {
    die 'npm is unavailable'
    return 1
  }

  resolved_latest_version=$("$NPM_BIN" view @deepseek-ai/dsh@latest version) || {
    die 'could not resolve the latest DSH version'
    return 1
  }
  case "$resolved_latest_version" in
    ''|*[!0-9A-Za-z.-]*)
      die 'latest DSH version is malformed'
      return 1
      ;;
  esac
  latest_version_pattern='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$'
  [[ "$resolved_latest_version" =~ $latest_version_pattern ]] || {
    die 'latest DSH version is malformed'
    return 1
  }

  LATEST_VERSION=$resolved_latest_version
}

resolve_release_cli() {
  [ "$#" -eq 2 ] || return 1
  resolve_release_root=$1
  resolve_cli_relative=$2
  cli_relative_safe "$resolve_cli_relative" || return 1
  [ -d "$resolve_release_root" ] && [ ! -L "$resolve_release_root" ] || return 1

  resolved_release_root=$(CDPATH='' cd -P -- "$resolve_release_root" && pwd) || return 1
  cli_candidate="$resolved_release_root/$resolve_cli_relative"
  [ -f "$cli_candidate" ] && [ ! -L "$cli_candidate" ] || return 1
  cli_parent=$(CDPATH='' cd -P -- "$(dirname -- "$cli_candidate")" && pwd) || return 1
  case "$cli_parent/" in
    "$resolved_release_root/"*) ;;
    *) return 1 ;;
  esac

  RESOLVED_CLI_ENTRY="$cli_parent/$(basename -- "$cli_candidate")"
}

cli_version_matches() (
  [ "$#" -eq 2 ] || return 1
  expected_cli_version=$1
  cli_version_text=$2
  [ -n "$cli_version_text" ] || return 1
  case "$cli_version_text" in
    *"
"*) return 1 ;;
  esac

  cli_version_pattern='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$'
  matched_cli_version=
  cli_version_count=0
  set -f
  for cli_version_token in $cli_version_text; do
    case "$cli_version_token" in
      v[0-9]*) cli_version_token=${cli_version_token#v} ;;
    esac
    if [[ "$cli_version_token" =~ $cli_version_pattern ]]; then
      matched_cli_version=$cli_version_token
      cli_version_count=$((cli_version_count + 1))
    fi
  done
  [ "$cli_version_count" -eq 1 ] && [ "$matched_cli_version" = "$expected_cli_version" ]
)

release_root_is_owned() {
  [ "$#" -eq 0 ] || return 1
  [ -d "$DSH_SERVICE_ROOT" ] && [ ! -L "$DSH_SERVICE_ROOT" ] || return 1
  [ -d "$RELEASES_DIR" ] && [ ! -L "$RELEASES_DIR" ] || return 1

  owned_root_physical=$(CDPATH='' cd -P -- "$DSH_SERVICE_ROOT" && pwd) || return 1
  owned_releases_physical=$(CDPATH='' cd -P -- "$RELEASES_DIR" && pwd) || return 1
  [ "$owned_releases_physical" = "$owned_root_physical/releases" ]
}

release_dir_is_owned() {
  [ "$#" -eq 1 ] || return 1
  release_root_is_owned || return 1
  owned_release_candidate=$1
  [ -d "$owned_release_candidate" ] && [ ! -L "$owned_release_candidate" ] || return 1
  owned_release_physical=$(CDPATH='' cd -P -- "$owned_release_candidate" && pwd) || return 1
  owned_release_parent=$(CDPATH='' cd -P -- "$owned_release_physical/.." && pwd) || return 1
  [ "$owned_release_parent" = "$owned_releases_physical" ]
}

validate_release() {
  [ "$#" -eq 1 ] || {
    die 'validate_release requires a release path'
    return 1
  }
  release_path=$1
  release_dir_is_owned "$release_path" || {
    die 'release directory is unavailable'
    return 1
  }
  [ -f "$release_path/.complete" ] && [ ! -L "$release_path/.complete" ] || {
    die 'release is incomplete'
    return 1
  }
  [ -f "$release_path/run" ] && [ -x "$release_path/run" ] && [ ! -L "$release_path/run" ] || {
    die 'release runner is unavailable'
    return 1
  }

  read_manifest "$release_path/manifest.env" || return 1
  resolve_release_cli "$release_path" "$MANIFEST_CLI_RELATIVE" || {
    die 'release CLI path is invalid'
    return 1
  }
  release_cli_entry=$RESOLVED_CLI_ENTRY

  runner_version=$("$release_path/run" --check) || {
    die 'release runner validation failed'
    return 1
  }
  [ "$runner_version" = "$MANIFEST_DSH_VERSION" ] || {
    die 'release runner reported the wrong version'
    return 1
  }
  cli_version_output=$("$MANIFEST_NODE_BIN" "$release_cli_entry" --version 2>&1) || {
    die 'release CLI version probe failed'
    return 1
  }
  cli_version_matches "$MANIFEST_DSH_VERSION" "$cli_version_output" || {
    die 'release CLI reported the wrong version'
    return 1
  }
}

current_release_id() {
  [ "$#" -eq 0 ] || return 1
  [ -L "$CURRENT_LINK" ] || return 1
  current_target=$(/usr/bin/readlink "$CURRENT_LINK") || return 1
  case "$current_target" in
    releases/*) current_id=${current_target#releases/} ;;
    *) return 1 ;;
  esac
  validate_release_id "$current_id" || return 1
  release_dir_is_owned "$RELEASES_DIR/$current_id" || return 1
  printf '%s\n' "$current_id"
}

atomic_release_link() {
  [ "$#" -eq 2 ] || {
    die 'atomic_release_link requires a link path and release ID'
    return 1
  }
  link_path=$1
  release_id=$2
  case "$link_path" in
    "$CURRENT_LINK"|"$PREVIOUS_LINK") ;;
    *)
      die 'release link path is not manager-owned'
      return 1
      ;;
  esac
  validate_release_id "$release_id" || {
    die 'release ID is invalid'
    return 1
  }
  release_dir_is_owned "$RELEASES_DIR/$release_id" || {
    die 'release directory does not exist'
    return 1
  }
  if { [ -e "$link_path" ] || [ -L "$link_path" ]; } && [ ! -L "$link_path" ]; then
    die 'release link target must be absent or a symlink'
    return 1
  fi

  link_serial=$$
  link_tmp="$DSH_SERVICE_ROOT/.release-link-$link_serial"
  while [ -e "$link_tmp" ] || [ -L "$link_tmp" ]; do
    link_serial=$((link_serial + 1))
    link_tmp="$DSH_SERVICE_ROOT/.release-link-$link_serial"
  done
  expected_link_target="releases/$release_id"
  /bin/ln -s "$expected_link_target" "$link_tmp" || {
    die 'could not create temporary release link'
    return 1
  }
  if ! /bin/mv -fh "$link_tmp" "$link_path"; then
    /bin/rm -f -- "$link_tmp"
    die 'could not publish release link'
    return 1
  fi
  published_link_target=$(/usr/bin/readlink "$link_path" 2>/dev/null) || {
    die 'published release link is invalid'
    return 1
  }
  [ -L "$link_path" ] && [ "$published_link_target" = "$expected_link_target" ] || {
    die 'published release link is invalid'
    return 1
  }
}

current_matches() {
  [ "$#" -eq 1 ] || return 1
  wanted_version=$1
  matching_release_id=$(current_release_id) || return 1
  matching_release_path="$RELEASES_DIR/$matching_release_id"
  validate_release "$matching_release_path" || return 1
  [ "$MANIFEST_DSH_VERSION" = "$wanted_version" ] || return 1
  printf '%s\n' "$matching_release_id"
}

remove_staging_release() {
  [ "$#" -eq 1 ] || return 1
  case "$1" in
    "$RELEASES_DIR"/.staging-*)
      /bin/rm -rf -- "$1" || return 1
      if [ "${ACTIVE_STAGING_RELEASE:-}" = "$1" ]; then
        ACTIVE_STAGING_RELEASE=
      fi
      ;;
    *) return 1 ;;
  esac
}

stage_release() {
  [ "$#" -eq 0 ] || {
    die 'stage_release accepts no arguments'
    return 1
  }
  resolve_latest_version || return 1

  matching_release=$(current_matches "$LATEST_VERSION" 2>/dev/null) && {
    STAGED_RELEASE_ID=$matching_release
    STAGED_RELEASE_PATH="$RELEASES_DIR/$matching_release"
    return 0
  }

  [ -n "${NODE_BIN:-}" ] && [ -f "$NODE_BIN" ] && [ -x "$NODE_BIN" ] || {
    die 'Node.js is unavailable'
    return 1
  }
  [ -f "$RUNNER_TEMPLATE" ] && [ -x "$RUNNER_TEMPLATE" ] && [ ! -L "$RUNNER_TEMPLATE" ] || {
    die 'manager-owned runner template is unavailable'
    return 1
  }
  if [ -d "$RELEASES_DIR" ] && [ ! -L "$RELEASES_DIR" ]; then
    : "${INSTALL_CREATED_RELEASES:=0}"
  else
    if [ -e "$RELEASES_DIR" ] || [ -L "$RELEASES_DIR" ]; then
      die 'releases directory path is unsafe'
      return 1
    fi
    /bin/mkdir "$RELEASES_DIR" || {
      die 'could not create releases directory'
      return 1
    }
    INSTALL_CREATED_RELEASES=1
  fi

  installed_at=$(/bin/date +%s) || {
    die 'could not read installation time'
    return 1
  }
  release_serial=$$
  while :; do
    release_id="$LATEST_VERSION-$installed_at-$release_serial"
    validate_release_id "$release_id" || {
      die 'could not create a valid release ID'
      return 1
    }
    final_release="$RELEASES_DIR/$release_id"
    staging_release="$RELEASES_DIR/.staging-$installed_at-$release_serial"
    if [ ! -e "$final_release" ] && [ ! -L "$final_release" ] &&
      [ ! -e "$staging_release" ] && [ ! -L "$staging_release" ]; then
      break
    fi
    release_serial=$((release_serial + 1))
  done

  /bin/mkdir "$staging_release" || {
    die 'could not create staging directory'
    return 1
  }
  ACTIVE_STAGING_RELEASE=$staging_release

  if ! "$NPM_BIN" install --prefix "$staging_release" "@deepseek-ai/dsh@$LATEST_VERSION" \
    --no-save --package-lock=false --omit=dev --no-audit --no-fund; then
    remove_staging_release "$staging_release" || :
    die 'could not install DSH release'
    return 1
  fi
  [ ! -e "$staging_release/package-lock.json" ] || {
    remove_staging_release "$staging_release" || :
    die 'npm created an unexpected package lock'
    return 1
  }

  package_json="$staging_release/node_modules/@deepseek-ai/dsh/package.json"
  [ -f "$package_json" ] && [ ! -L "$package_json" ] || {
    remove_staging_release "$staging_release" || :
    die 'installed DSH package metadata is unavailable'
    return 1
  }
  package_metadata=$("$NODE_BIN" -e '
const fs = require("fs");
const pkg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
if (typeof pkg.version !== "string" || !pkg.bin || typeof pkg.bin.dsh !== "string") process.exit(1);
process.stdout.write(pkg.version + "\n" + pkg.bin.dsh + "\n");
' "$package_json") || {
    remove_staging_release "$staging_release" || :
    die 'could not read installed DSH package metadata'
    return 1
  }
  metadata_newline='
'
  case "$package_metadata" in
    *"$metadata_newline"*) ;;
    *)
      remove_staging_release "$staging_release" || :
      die 'installed DSH package metadata is malformed'
      return 1
      ;;
  esac
  installed_version=${package_metadata%%"$metadata_newline"*}
  package_cli=${package_metadata#*"$metadata_newline"}
  case "$package_cli" in
    *"$metadata_newline"*|'')
      remove_staging_release "$staging_release" || :
      die 'installed DSH package metadata is malformed'
      return 1
      ;;
  esac
  [ "$installed_version" = "$LATEST_VERSION" ] || {
    remove_staging_release "$staging_release" || :
    die 'installed DSH package version does not match latest'
    return 1
  }
  while case "$package_cli" in ./*) true ;; *) false ;; esac; do
    package_cli=${package_cli#./}
  done
  cli_relative="node_modules/@deepseek-ai/dsh/$package_cli"
  cli_relative_safe "$cli_relative" || {
    remove_staging_release "$staging_release" || :
    die 'installed DSH CLI path is unsafe'
    return 1
  }
  resolve_release_cli "$staging_release" "$cli_relative" || {
    remove_staging_release "$staging_release" || :
    die 'installed DSH CLI escapes staging'
    return 1
  }
  staged_cli_entry=$RESOLVED_CLI_ENTRY

  manifest_tmp="$staging_release/.manifest-$release_serial"
  if ! (
    umask 077
    {
      printf 'SCHEMA_VERSION=1\n'
      printf 'DSH_VERSION=%s\n' "$installed_version"
      printf 'NODE_BIN=%s\n' "$NODE_BIN"
      printf 'CLI_RELATIVE=%s\n' "$cli_relative"
      printf 'INSTALLED_AT=%s\n' "$installed_at"
    } >"$manifest_tmp"
  ); then
    remove_staging_release "$staging_release" || :
    die 'could not write release manifest'
    return 1
  fi
  if ! /bin/mv "$manifest_tmp" "$staging_release/manifest.env"; then
    remove_staging_release "$staging_release" || :
    die 'could not publish release manifest'
    return 1
  fi
  if ! /bin/cp "$RUNNER_TEMPLATE" "$staging_release/run" ||
    ! /bin/chmod 0755 "$staging_release/run"; then
    remove_staging_release "$staging_release" || :
    die 'could not install release runner'
    return 1
  fi

  staged_runner_version=$("$staging_release/run" --check) || {
    remove_staging_release "$staging_release" || :
    die 'staged runner validation failed'
    return 1
  }
  [ "$staged_runner_version" = "$installed_version" ] || {
    remove_staging_release "$staging_release" || :
    die 'staged runner reported the wrong version'
    return 1
  }
  staged_cli_output=$("$NODE_BIN" "$staged_cli_entry" --version 2>&1) || {
    remove_staging_release "$staging_release" || :
    die 'staged DSH version probe failed'
    return 1
  }
  cli_version_matches "$installed_version" "$staged_cli_output" || {
    remove_staging_release "$staging_release" || :
    die 'staged DSH reported the wrong version'
    return 1
  }

  : >"$staging_release/.complete" || {
    remove_staging_release "$staging_release" || :
    die 'could not mark staged release complete'
    return 1
  }
  if ! /bin/mv "$staging_release" "$final_release"; then
    remove_staging_release "$staging_release" || :
    die 'could not publish staged release'
    return 1
  fi
  ACTIVE_STAGING_RELEASE=

  STAGED_RELEASE_ID=$release_id
  STAGED_RELEASE_PATH=$final_release
}

read_lock_owner() {
  [ -f "$LOCK_DIR/pid" ] || return 1
  lock_owner=
  lock_owner_lines=0
  while IFS= read -r lock_owner_line || [ -n "$lock_owner_line" ]; do
    lock_owner=$lock_owner_line
    lock_owner_lines=$((lock_owner_lines + 1))
  done <"$LOCK_DIR/pid"
  [ "$lock_owner_lines" -eq 1 ] || return 1
  case "$lock_owner" in
    ''|0|*[!0-9]*) return 1 ;;
  esac
  printf '%s\n' "$lock_owner"
}

release_lock_if_owned() {
  [ -d "$LOCK_DIR" ] || return 0
  [ ! -L "$LOCK_DIR" ] || return 0
  current_owner=$(read_lock_owner) || return 0
  [ "$current_owner" = "$$" ] || return 0
  /bin/rm -f -- "$LOCK_DIR/pid" || return 0
  /bin/rmdir -- "$LOCK_DIR" 2>/dev/null || return 0
}

release_lock() {
  [ -d "$LOCK_DIR" ] || {
    die 'operation lock does not exist'
    return 1
  }
  [ ! -L "$LOCK_DIR" ] || {
    die 'operation lock must not be a symlink'
    return 1
  }
  current_owner=$(read_lock_owner) || {
    die 'operation lock owner is malformed'
    return 1
  }
  [ "$current_owner" = "$$" ] || {
    die 'operation lock is owned by another process'
    return 1
  }
  /bin/rm -f -- "$LOCK_DIR/pid" || {
    die 'could not remove operation lock owner file'
    return 1
  }
  /bin/rmdir -- "$LOCK_DIR" || {
    die 'could not remove operation lock directory'
    return 1
  }
}

operation_exit_cleanup() {
  local manager_transaction_was_active install_cleanup_was_active
  manager_transaction_was_active=${MANAGER_TRANSACTION_ACTIVE:-0}
  install_cleanup_was_active=${INSTALL_CLEANUP_ACTIVE:-0}

  if [ "$manager_transaction_was_active" -eq 1 ]; then
    restore_manager_cli || :
  fi
  if [ "$install_cleanup_was_active" -eq 1 ]; then
    cleanup_install_directories || :
  fi
  release_lock_if_owned
  if [ "$install_cleanup_was_active" -eq 1 ]; then
    cleanup_install_directories || :
    INSTALL_CLEANUP_ACTIVE=0
  fi
}

acquire_lock() {
  if /bin/mkdir "$LOCK_DIR" 2>/dev/null; then
    if printf '%s\n' "$$" >"$LOCK_DIR/pid"; then
      trap 'operation_exit_cleanup' EXIT
      trap 'exit 130' INT
      trap 'exit 143' TERM
      return 0
    fi
    /bin/rmdir -- "$LOCK_DIR" 2>/dev/null || :
    die 'could not record operation lock owner'
    return 1
  fi

  [ -d "$LOCK_DIR" ] || {
    die 'could not create operation lock'
    return 1
  }
  [ ! -L "$LOCK_DIR" ] || {
    die 'operation lock must not be a symlink'
    return 1
  }
  stale_owner=$(read_lock_owner) || {
    die 'operation lock owner is missing or malformed'
    return 1
  }
  if kill -0 "$stale_owner" 2>/dev/null; then
    die "another dsh-service operation is running (pid $stale_owner)"
    return 1
  fi

  current_owner=$(read_lock_owner) || {
    die 'operation lock changed while checking its owner'
    return 1
  }
  [ "$current_owner" = "$stale_owner" ] || {
    die 'operation lock changed while checking its owner'
    return 1
  }
  /bin/rm -f -- "$LOCK_DIR/pid" || {
    die 'could not remove stale operation lock owner file'
    return 1
  }
  /bin/rmdir -- "$LOCK_DIR" || {
    die 'could not remove stale operation lock directory'
    return 1
  }
  /bin/mkdir "$LOCK_DIR" 2>/dev/null || {
    die 'operation lock was acquired by another process'
    return 1
  }
  if printf '%s\n' "$$" >"$LOCK_DIR/pid"; then
    trap 'operation_exit_cleanup' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    return 0
  fi
  /bin/rmdir -- "$LOCK_DIR" 2>/dev/null || :
  die 'could not record operation lock owner'
  return 1
}

record_install_directory() {
  [ "$#" -eq 2 ] || return 1
  local directory_path directory_flag
  directory_path=$1
  directory_flag=$2
  if [ -d "$directory_path" ] && [ ! -L "$directory_path" ]; then
    eval "$directory_flag=0"
    return 0
  fi
  if [ -e "$directory_path" ] || [ -L "$directory_path" ]; then
    die "install directory path is unsafe: $directory_path"
    return 1
  fi
  /bin/mkdir "$directory_path" || {
    die "could not create install directory: $directory_path"
    return 1
  }
  eval "$directory_flag=1"
}

prepare_install_lock_root() {
  [ "$#" -eq 0 ] || return 1
  INSTALL_CREATED_ROOT_GRANDPARENT=0
  INSTALL_CREATED_ROOT_PARENT=0
  INSTALL_CREATED_ROOT=0
  INSTALL_CREATED_LIBEXEC=0
  INSTALL_CREATED_RELEASES=0
  INSTALL_CREATED_LOCAL=0
  INSTALL_CREATED_BIN=0
  ACTIVE_STAGING_RELEASE=

  if [ -n "$ROOT_GRANDPARENT_DIR" ]; then
    record_install_directory "$ROOT_GRANDPARENT_DIR" INSTALL_CREATED_ROOT_GRANDPARENT || return 1
    record_install_directory "$ROOT_PARENT_DIR" INSTALL_CREATED_ROOT_PARENT || return 1
  else
    [ -d "${XDG_DATA_HOME:-}" ] && [ ! -L "${XDG_DATA_HOME:-}" ] || {
      die 'XDG_DATA_HOME must be an existing physical directory'
      return 1
    }
  fi
  record_install_directory "$DSH_SERVICE_ROOT" INSTALL_CREATED_ROOT
}

prepare_install_payload_directories() {
  [ "$#" -eq 0 ] || return 1
  record_install_directory "$DSH_SERVICE_ROOT/libexec" INSTALL_CREATED_LIBEXEC || return 1
  record_install_directory "$HOME/.local" INSTALL_CREATED_LOCAL || return 1
  record_install_directory "${CLI_DEST%/*}" INSTALL_CREATED_BIN
}

cleanup_install_directories() {
  [ "$#" -eq 0 ] || return 1
  if [ -n "${ACTIVE_STAGING_RELEASE:-}" ]; then
    remove_staging_release "$ACTIVE_STAGING_RELEASE" || :
  fi
  [ "${INSTALL_CREATED_RELEASES:-0}" -eq 0 ] || /bin/rmdir -- "$RELEASES_DIR" 2>/dev/null || :
  [ "${INSTALL_CREATED_BIN:-0}" -eq 0 ] || /bin/rmdir -- "${CLI_DEST%/*}" 2>/dev/null || :
  [ "${INSTALL_CREATED_LOCAL:-0}" -eq 0 ] || /bin/rmdir -- "$HOME/.local" 2>/dev/null || :
  [ "${INSTALL_CREATED_LIBEXEC:-0}" -eq 0 ] || /bin/rmdir -- "$DSH_SERVICE_ROOT/libexec" 2>/dev/null || :
  [ "${INSTALL_CREATED_ROOT:-0}" -eq 0 ] || /bin/rmdir -- "$DSH_SERVICE_ROOT" 2>/dev/null || :
  [ "${INSTALL_CREATED_ROOT_PARENT:-0}" -eq 0 ] || [ -z "$ROOT_PARENT_DIR" ] || /bin/rmdir -- "$ROOT_PARENT_DIR" 2>/dev/null || :
  [ "${INSTALL_CREATED_ROOT_GRANDPARENT:-0}" -eq 0 ] || [ -z "$ROOT_GRANDPARENT_DIR" ] || /bin/rmdir -- "$ROOT_GRANDPARENT_DIR" 2>/dev/null || :
}

next_manager_transaction_path() {
  [ "$#" -eq 2 ] || return 1
  local transaction_dir transaction_kind transaction_serial transaction_path
  transaction_dir=$1
  transaction_kind=$2
  transaction_serial=$$
  transaction_path="$transaction_dir/.dsh-service-$transaction_kind-$transaction_serial"
  while [ -e "$transaction_path" ] || [ -L "$transaction_path" ]; do
    transaction_serial=$((transaction_serial + 1))
    transaction_path="$transaction_dir/.dsh-service-$transaction_kind-$transaction_serial"
  done
  printf '%s\n' "$transaction_path"
}

restore_manager_destination() {
  [ "$#" -eq 3 ] || return 1
  local destination state backup restore_status
  destination=$1
  state=$2
  backup=$3
  restore_status=0
  case "$state" in
    noop) ;;
    new)
      if [ -e "$destination" ] || [ -L "$destination" ]; then
        /bin/rm -f -- "$destination" || restore_status=1
      fi
      ;;
    replaced)
      if [ -e "$backup" ] || [ -L "$backup" ]; then
        if [ -e "$destination" ] || [ -L "$destination" ]; then
          /bin/rm -f -- "$destination" || restore_status=1
        fi
        if [ "$restore_status" -eq 0 ]; then
          /bin/mv "$backup" "$destination" || restore_status=1
        fi
      fi
      ;;
    '') ;;
    *) restore_status=1 ;;
  esac
  return "$restore_status"
}

restore_manager_cli() {
  [ "$#" -eq 0 ] || return 1
  local restore_status
  restore_status=0
  if [ -n "${MANAGER_RUNNER_TEMP:-}" ] &&
    { [ -e "$MANAGER_RUNNER_TEMP" ] || [ -L "$MANAGER_RUNNER_TEMP" ]; }; then
    /bin/rm -f -- "$MANAGER_RUNNER_TEMP" || restore_status=1
  fi
  if [ -n "${MANAGER_CLI_TEMP:-}" ] &&
    { [ -e "$MANAGER_CLI_TEMP" ] || [ -L "$MANAGER_CLI_TEMP" ]; }; then
    /bin/rm -f -- "$MANAGER_CLI_TEMP" || restore_status=1
  fi
  restore_manager_destination "$RUNNER_TEMPLATE" "${MANAGER_RUNNER_STATE:-}" \
    "${MANAGER_RUNNER_BACKUP:-}" || restore_status=1
  restore_manager_destination "$CLI_DEST" "${MANAGER_CLI_STATE:-}" \
    "${MANAGER_CLI_BACKUP:-}" || restore_status=1
  MANAGER_TRANSACTION_ACTIVE=0
  return "$restore_status"
}

finish_manager_cli() {
  [ "$#" -eq 0 ] || return 1
  local finish_status
  finish_status=0
  if [ "${MANAGER_RUNNER_STATE:-}" = replaced ]; then
    /bin/rm -f -- "$MANAGER_RUNNER_BACKUP" || finish_status=1
  fi
  if [ "${MANAGER_CLI_STATE:-}" = replaced ]; then
    /bin/rm -f -- "$MANAGER_CLI_BACKUP" || finish_status=1
  fi
  MANAGER_TRANSACTION_ACTIVE=0
  return "$finish_status"
}

install_manager_cli() {
  [ "$#" -eq 0 ] || return 1
  local manager_install_status
  MANAGER_CLI_STATE=noop
  MANAGER_RUNNER_STATE=noop
  MANAGER_CLI_TEMP=
  MANAGER_RUNNER_TEMP=
  MANAGER_CLI_BACKUP=
  MANAGER_RUNNER_BACKUP=
  MANAGER_TRANSACTION_ACTIVE=1
  manager_install_status=0

  if [ ! -e "$CLI_DEST" ] || ! [ "$MANAGER_CLI_SOURCE" -ef "$CLI_DEST" ]; then
    MANAGER_CLI_TEMP=$(next_manager_transaction_path "${CLI_DEST%/*}" cli-new) || return 1
    /bin/cp "$MANAGER_CLI_SOURCE" "$MANAGER_CLI_TEMP" || manager_install_status=1
    if [ "$manager_install_status" -eq 0 ]; then
      /bin/chmod 0755 "$MANAGER_CLI_TEMP" || manager_install_status=1
    fi
    if [ "$manager_install_status" -eq 0 ]; then
      /bin/bash -n "$MANAGER_CLI_TEMP" || manager_install_status=1
    fi
    if [ -e "$CLI_DEST" ] || [ -L "$CLI_DEST" ]; then
      MANAGER_CLI_STATE=replaced
      MANAGER_CLI_BACKUP=$(next_manager_transaction_path "${CLI_DEST%/*}" cli-backup) || return 1
    else
      MANAGER_CLI_STATE=new
    fi
  fi

  if [ "$manager_install_status" -eq 0 ] &&
    { [ ! -e "$RUNNER_TEMPLATE" ] || ! [ "$MANAGER_RUNNER_SOURCE" -ef "$RUNNER_TEMPLATE" ]; }; then
    MANAGER_RUNNER_TEMP=$(next_manager_transaction_path "${RUNNER_TEMPLATE%/*}" runner-new) || return 1
    /bin/cp "$MANAGER_RUNNER_SOURCE" "$MANAGER_RUNNER_TEMP" || manager_install_status=1
    if [ "$manager_install_status" -eq 0 ]; then
      /bin/chmod 0755 "$MANAGER_RUNNER_TEMP" || manager_install_status=1
    fi
    if [ "$manager_install_status" -eq 0 ]; then
      /bin/bash -n "$MANAGER_RUNNER_TEMP" || manager_install_status=1
    fi
    if [ -e "$RUNNER_TEMPLATE" ] || [ -L "$RUNNER_TEMPLATE" ]; then
      MANAGER_RUNNER_STATE=replaced
      MANAGER_RUNNER_BACKUP=$(next_manager_transaction_path "${RUNNER_TEMPLATE%/*}" runner-backup) || return 1
    else
      MANAGER_RUNNER_STATE=new
    fi
  fi

  if [ "$manager_install_status" -eq 0 ] && [ "$MANAGER_CLI_STATE" = replaced ]; then
    /bin/mv "$CLI_DEST" "$MANAGER_CLI_BACKUP" || manager_install_status=1
  fi
  if [ "$manager_install_status" -eq 0 ] && [ "$MANAGER_RUNNER_STATE" = replaced ]; then
    /bin/mv "$RUNNER_TEMPLATE" "$MANAGER_RUNNER_BACKUP" || manager_install_status=1
  fi
  if [ "$manager_install_status" -eq 0 ] && [ "$MANAGER_CLI_STATE" != noop ]; then
    /bin/mv "$MANAGER_CLI_TEMP" "$CLI_DEST" || manager_install_status=1
  fi
  if [ "$manager_install_status" -eq 0 ] && [ "$MANAGER_RUNNER_STATE" != noop ]; then
    /bin/mv "$MANAGER_RUNNER_TEMP" "$RUNNER_TEMPLATE" || manager_install_status=1
  fi

  if [ "$manager_install_status" -ne 0 ]; then
    restore_manager_cli || die 'could not restore manager files'
    die 'could not install manager files'
    return 1
  fi
  [ -f "$CLI_DEST" ] && [ -x "$CLI_DEST" ] && [ ! -L "$CLI_DEST" ] || {
    restore_manager_cli || :
    die 'installed manager command is invalid'
    return 1
  }
  [ -f "$RUNNER_TEMPLATE" ] && [ -x "$RUNNER_TEMPLATE" ] && [ ! -L "$RUNNER_TEMPLATE" ] || {
    restore_manager_cli || :
    die 'installed manager runner is invalid'
    return 1
  }
}

warn_if_no_linger() {
  [ "$#" -eq 0 ] || return 1
  [ "$PLATFORM" = linux ] || return 0
  local linger_state install_user
  install_user=$(/usr/bin/id -un) || return 0
  [ -f "$LOGINCTL_BIN" ] && [ -x "$LOGINCTL_BIN" ] || return 0
  linger_state=$("$LOGINCTL_BIN" show-user --value -p Linger "$install_user" 2>/dev/null) || return 0
  [ "$linger_state" = no ] || return 0
  note 'lingering is off: the service stops at logout and returns at next login'
  note "for always-on servers run: loginctl enable-linger $install_user"
}

print_path_hint() {
  [ "$#" -eq 0 ] || return 1
  local manager_bin
  manager_bin=${CLI_DEST%/*}
  case ":${PATH:-}:" in
    *":$manager_bin:"*) return 0 ;;
  esac
  printf 'Add dsh-service to PATH:\n' >&2
  printf '  export PATH="%s:$PATH"\n' "$manager_bin" >&2
  printf 'Executable: %s\n' "$CLI_DEST" >&2
}

preflight_service_command() {
  [ "$#" -eq 0 ] || return 1
  if [ "$PLATFORM" = darwin ]; then
    preflight_common "$PLUTIL_BIN" "$LISTENER_BIN" "$CURL_BIN" || return 1
  else
    preflight_common "$LISTENER_BIN" "$CURL_BIN" || return 1
  fi
  [ -d "$DSH_SERVICE_ROOT" ] && [ ! -L "$DSH_SERVICE_ROOT" ] || {
    die 'dsh-service is not installed'
    return 1
  }
}

run_locked_service_command() {
  [ "$#" -eq 1 ] || return 1
  local service_action service_status
  service_action=$1
  preflight_service_command || return 1
  acquire_lock || return 1
  service_status=0
  recover_activation || service_status=1
  if [ "$service_status" -eq 0 ]; then
    case "$service_action" in
      start) start_service || service_status=1 ;;
      stop) stop_service || service_status=1 ;;
      restart) restart_service || service_status=1 ;;
      *) service_status=1 ;;
    esac
  fi
  if ! release_lock; then
    return 1
  fi
  return "$service_status"
}

cmd_start() {
  [ "$#" -eq 0 ] || return 64
  run_locked_service_command start
}

cmd_stop() {
  [ "$#" -eq 0 ] || return 64
  run_locked_service_command stop
}

cmd_restart() {
  [ "$#" -eq 0 ] || return 64
  run_locked_service_command restart
}

cmd_install() {
  [ "$#" -eq 0 ] || {
    die 'usage: dsh-service install'
    return 64
  }
  local install_status staged_release current_id
  preflight_install || return 1
  prepare_install_lock_root || {
    cleanup_install_directories
    return 1
  }
  INSTALL_CLEANUP_ACTIVE=1
  if ! acquire_lock; then
    cleanup_install_directories
    INSTALL_CLEANUP_ACTIVE=0
    return 1
  fi

  install_status=0
  prepare_install_payload_directories || install_status=1
  if [ "$install_status" -eq 0 ]; then
    install_manager_cli || install_status=1
  fi
  if [ "$install_status" -eq 0 ]; then
    recover_activation || install_status=1
  fi
  if [ "$install_status" -eq 0 ]; then
    stage_release || install_status=1
  fi
  if [ "$install_status" -eq 0 ]; then
    ensure_service_definition || install_status=1
  fi
  if [ "$install_status" -eq 0 ]; then
    staged_release=$STAGED_RELEASE_ID
    current_id=$(current_release_id 2>/dev/null) || current_id=
    if [ "$staged_release" = "$current_id" ]; then
      if ! health_state >/dev/null && { ! start_service || ! wait_for_health; }; then
        install_status=1
      fi
    elif ! activate_release "$staged_release"; then
      install_status=1
    fi
  fi
  if [ "$install_status" -eq 0 ]; then
    cmd_open || install_status=1
  fi

  if [ "$install_status" -eq 0 ]; then
    finish_manager_cli || install_status=1
  else
    restore_manager_cli || :
  fi
  if ! release_lock; then
    install_status=1
  fi
  if [ "$install_status" -ne 0 ]; then
    cleanup_install_directories
    INSTALL_CLEANUP_ACTIVE=0
    return 1
  fi
  INSTALL_CLEANUP_ACTIVE=0
  warn_if_no_linger || :
  print_path_hint
}

cmd_status() {
  [ "$#" -eq 0 ] || {
    die 'usage: dsh-service status'
    return 64
  }
  local status_dsh_version status_supervisor status_pid status_health status_code supervisor_label
  preflight_common "$LISTENER_BIN" "$CURL_BIN" || return 1

  status_dsh_version='not installed'
  if status_release_id=$(current_release_id 2>/dev/null) &&
    read_manifest "$RELEASES_DIR/$status_release_id/manifest.env" 2>/dev/null; then
    status_dsh_version=$MANIFEST_DSH_VERSION
  fi
  status_supervisor=unloaded
  status_pid='-'
  if service_loaded; then
    status_supervisor=loaded
    status_pid=$(service_pid 2>/dev/null) || status_pid='-'
  fi

  status_code=0
  if [ -e "$ACTIVATION_FILE" ] || [ -L "$ACTIVATION_FILE" ]; then
    status_health=interrupted
    status_code=1
  else
    status_health=$(health_state)
    status_code=$?
  fi

  case "$PLATFORM" in
    darwin) supervisor_label=Launchd ;;
    linux) supervisor_label=Systemd ;;
    *) supervisor_label=Supervisor ;;
  esac
  printf 'Manager version: %s\n' "$MANAGER_VERSION"
  printf 'DSH version: %s\n' "$status_dsh_version"
  printf '%s: %s\n' "$supervisor_label" "$status_supervisor"
  printf 'PID: %s\n' "$status_pid"
  printf 'URL: %s\n' 'http://127.0.0.1:3080'
  printf 'Health: %s\n' "$status_health"
  return "$status_code"
}

open_linux_url() {
  [ "$#" -eq 0 ] || return 1
  local xdg_open_bin
  if [ "${DSH_SERVICE_TESTING:-0}" = 1 ] && [ -n "${DSH_SERVICE_XDG_OPEN_BIN:-}" ]; then
    xdg_open_bin=$DSH_SERVICE_XDG_OPEN_BIN
    [ -f "$xdg_open_bin" ] && [ -x "$xdg_open_bin" ] || xdg_open_bin=
  else
    xdg_open_bin=$(resolve_external_command xdg-open) || xdg_open_bin=
  fi
  if [ -n "$xdg_open_bin" ] && "$xdg_open_bin" http://127.0.0.1:3080 2>/dev/null; then
    return 0
  fi
  note 'no graphical opener was found; open this URL in a browser'
  note 'on a remote machine, tunnel first: ssh -L 3080:127.0.0.1:3080 <host>'
  printf '%s\n' 'http://127.0.0.1:3080'
}

cmd_open() {
  [ "$#" -eq 0 ] || {
    die 'usage: dsh-service open'
    return 64
  }
  if [ "$PLATFORM" = darwin ]; then
    preflight_common "$LISTENER_BIN" "$CURL_BIN" "$OPEN_BIN" || return 1
  else
    preflight_common "$LISTENER_BIN" "$CURL_BIN" || return 1
  fi
  if [ -e "$ACTIVATION_FILE" ] || [ -L "$ACTIVATION_FILE" ]; then
    die 'DSH activation was interrupted'
    return 1
  fi
  health_state >/dev/null || {
    die 'DSH service is not healthy'
    return 1
  }
  case "$PLATFORM" in
    darwin) "$OPEN_BIN" http://127.0.0.1:3080 ;;
    linux) open_linux_url ;;
    *) return 1 ;;
  esac
}

cmd_logs() {
  [ "$#" -eq 0 ] || {
    die 'usage: dsh-service logs'
    return 64
  }
  preflight_common "$TAIL_BIN" || return 1
  exec "$TAIL_BIN" -F "$LOG_DIR/stdout.log" "$LOG_DIR/stderr.log"
}

validate_uninstall_root() {
  [ "$#" -eq 0 ] || return 1
  local expected_root
  case "$HOME" in
    /*) ;;
    *) return 1 ;;
  esac
  [ -n "$HOME" ] || return 1
  case "$PLATFORM" in
    darwin) expected_root="$HOME/Library/Application Support/dsh-service" ;;
    linux) expected_root="${XDG_DATA_HOME:-$HOME/.local/share}/dsh-service" ;;
    *) return 1 ;;
  esac
  [ "$DSH_SERVICE_ROOT" = "$expected_root" ] || return 1
  [ "$DSH_SERVICE_ROOT" != / ] || return 1
  [ -d "$DSH_SERVICE_ROOT" ] && [ ! -L "$DSH_SERVICE_ROOT" ]
}

cmd_uninstall() {
  [ "$#" -eq 0 ] || {
    die 'usage: dsh-service uninstall'
    return 64
  }
  local uninstall_status
  preflight_common || return 1
  if { [ -e "$DSH_SERVICE_ROOT" ] || [ -L "$DSH_SERVICE_ROOT" ]; } &&
    { [ ! -d "$DSH_SERVICE_ROOT" ] || [ -L "$DSH_SERVICE_ROOT" ]; }; then
    die 'manager root is unsafe for uninstall'
    return 1
  fi
  prepare_install_lock_root || {
    cleanup_install_directories
    return 1
  }
  if ! acquire_lock; then
    cleanup_install_directories
    return 1
  fi

  uninstall_status=0
  case "$PLATFORM" in
    darwin)
      if service_loaded; then
        "$LAUNCHCTL_BIN" bootout "$SERVICE_TARGET" || {
          die 'could not boot out LaunchAgent'
          uninstall_status=1
        }
      fi
      ;;
    linux)
      if [ -e "$SERVICE_DEFINITION_PATH" ] || service_loaded; then
        "$SYSTEMCTL_BIN" --user disable --now "$SERVICE_TARGET" || {
          die 'could not disable the systemd unit'
          uninstall_status=1
        }
      fi
      ;;
    *) uninstall_status=1 ;;
  esac
  if [ "$uninstall_status" -eq 0 ]; then
    /bin/rm -f -- "$SERVICE_DEFINITION_PATH" || uninstall_status=1
  fi
  if [ "$uninstall_status" -eq 0 ] && [ "$PLATFORM" = linux ]; then
    "$SYSTEMCTL_BIN" --user daemon-reload || uninstall_status=1
  fi
  if [ "$uninstall_status" -eq 0 ]; then
    /bin/rm -f -- "$LOG_DIR/stdout.log" "$LOG_DIR/stderr.log" || uninstall_status=1
    /bin/rmdir -- "$LOG_DIR" 2>/dev/null || :
  fi
  if [ "$uninstall_status" -eq 0 ]; then
    validate_uninstall_root || {
      die 'manager root failed uninstall validation'
      uninstall_status=1
    }
  fi

  if [ "$uninstall_status" -ne 0 ]; then
    release_lock || :
    cleanup_install_directories
    return 1
  fi

  /bin/rm -rf -- "$DSH_SERVICE_ROOT" || {
    die 'could not remove manager root'
    return 1
  }
  trap - EXIT INT TERM
  /bin/rm -f -- "$CLI_DEST" || {
    die 'could not remove manager command'
    return 1
  }
}

cmd_update() {
  [ "$#" -eq 0 ] || {
    die 'usage: dsh-service update'
    return 1
  }
  local update_status staged_release current_id
  preflight_install || return 1
  [ -d "$DSH_SERVICE_ROOT" ] && [ ! -L "$DSH_SERVICE_ROOT" ] || {
    die 'dsh-service is not installed'
    return 1
  }
  acquire_lock || return 1

  update_status=0
  recover_activation || update_status=1
  if [ "$update_status" -eq 0 ]; then
    stage_release || update_status=1
  fi
  if [ "$update_status" -eq 0 ]; then
    staged_release=$STAGED_RELEASE_ID
    current_id=$(current_release_id 2>/dev/null) || current_id=
    if [ "$staged_release" = "$current_id" ]; then
      if health_state >/dev/null; then
        :
      elif ! start_service || ! wait_for_health; then
        update_status=1
      fi
    elif ! activate_release "$staged_release"; then
      update_status=1
    fi
  fi

  if ! release_lock; then
    return 1
  fi
  return "$update_status"
}

print_usage() {
  printf '%s\n' \
    'Usage: dsh-service COMMAND' \
    '' \
    'Commands:' \
    '  install    Install and start DSH' \
    '  start      Start the DSH service' \
    '  stop       Stop the DSH service' \
    '  restart    Restart the DSH service' \
    '  status     Show manager and service status' \
    '  open       Open the verified healthy service' \
    '  logs       Follow the service logs' \
    '  update     Install the latest DSH release' \
    '  uninstall  Remove dsh-service and its service' \
    '  version    Print the manager version' \
    '  help       Show this help'
}

usage_error() {
  print_usage >&2
  return 64
}

main() {
  [ "$#" -eq 1 ] || {
    usage_error
    return 64
  }
  command_name=$1
  case "$command_name" in
    install)
      shift
      cmd_install "$@"
      ;;
    start)
      shift
      cmd_start "$@"
      ;;
    stop)
      shift
      cmd_stop "$@"
      ;;
    restart)
      shift
      cmd_restart "$@"
      ;;
    help)
      print_usage
      ;;
    version)
      printf '%s\n' "$MANAGER_VERSION"
      ;;
    status)
      shift
      cmd_status "$@"
      ;;
    open)
      shift
      cmd_open "$@"
      ;;
    logs)
      shift
      cmd_logs "$@"
      ;;
    update)
      shift
      cmd_update "$@"
      ;;
    uninstall)
      shift
      cmd_uninstall "$@"
      ;;
    *)
      usage_error
      return 64
      ;;
  esac
}

if ! detect_platform; then
  return 1 2>/dev/null || exit 1
fi
init_command_paths
init_paths

if [ "${DSH_SERVICE_SOURCE_ONLY:-0}" = 1 ]; then
  return 0 2>/dev/null || exit 0
fi

main "$@"
